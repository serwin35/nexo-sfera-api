<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <ProjectGuid>{506A9277-8BD0-49DE-9F96-5B7B2DA66CEC}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>nexoZapytanie</RootNamespace>
    <AssemblyName>nexoZapytanie</AssemblyName>
    <nexoSdkBinPath>..\..\Bin\</nexoSdkBinPath>
    <nexoSdkNarzedziaPath>..\..\Narzedzia\</nexoSdkNarzedziaPath>
    <AbsolutePathToSdkBin>$(nexoSdkBinPath)</AbsolutePathToSdkBin>
    <AbsolutePathParam>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(nexoSdkBinPath)))</AbsolutePathParam>
    <AbsolutePathToSdkBin Condition=" '$([System.IO.Path]::IsPathRooted($(nexoSdkBinPath)))' != 'true' ">$([System.IO.Path]::GetFullPath($(AbsolutePathParam)))</AbsolutePathToSdkBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="InsERT.Moria.API">
      <HintPath>$(nexoSdkBinPath)InsERT.Moria.API.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.DaneDomyslne">
      <HintPath>$(nexoSdkBinPath)InsERT.Moria.DaneDomyslne.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.ModelDanych">
      <HintPath>$(nexoSdkBinPath)InsERT.Moria.ModelDanych.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Sfera">
      <HintPath>$(nexoSdkBinPath)InsERT.Moria.Sfera.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.Core">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFramework.Core">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.EntityFramework.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFrameworkSupport">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.EntityFrameworkSupport.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.DatabaseAccess">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.DatabaseAccess.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Include="LogowanieSerwer.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="LogowanieSerwer.Designer.cs">
      <DependentUpon>LogowanieSerwer.cs</DependentUpon>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SyntaxRichTextBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="Szyfrowanie.cs" />
    <Compile Include="WynikListaForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="WynikListaForm.Designer.cs">
      <DependentUpon>WynikListaForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Include="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="LogowanieSerwer.resx">
      <DependentUpon>LogowanieSerwer.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <EmbeddedResource Include="WynikListaForm.resx">
      <DependentUpon>WynikListaForm.cs</DependentUpon>
    </EmbeddedResource>
    <None Include="app.config" />
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="Konfiguracja.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ParametryInstalacji.txt" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /y &quot;$(AbsolutePathToSdkBin)Xml.pak&quot; &quot;$(TargetDir)\Xml.pak&quot;" />
    <Exec Command="copy /y &quot;$(nexoSdkBinPath)sni.dll&quot; &quot;$(TargetDir)sni.dll&quot;" />
    <Exec Command="copy /y &quot;$(nexoSdkBinPath)ijwhost.dll&quot; &quot;$(TargetDir)ijwhost.dll&quot;" />
    <Exec Command="copy /y &quot;$(nexoSdkBinPath)Microsoft.Data.SqlClient.SNI.dll&quot; &quot;$(TargetDir)Microsoft.Data.SqlClient.SNI.dll&quot;" />
    <Exec Command="if exist &quot;$(nexoSdkNarzedziaPath)PackageAndInstallerBuilder.exe&quot; (call &quot;$(nexoSdkNarzedziaPath)PackageAndInstallerBuilder.exe&quot; /PlikKonfiguracji:Konfiguracja.xml /KatalogDocelowy:&quot;$(TargetDir)\&quot;) else (echo Nie można zbudować pakietu i instalatora, ponieważ nie istnieje plik: &quot;$(nexoSdkNarzedziaPath)PackageAndInstallerBuilder.exe&quot;)" />
  </Target>
</Project>