    <Rodzaj>WlasnySQL</Rodzaj>
    <Nazwa>Lista towarów</Nazwa>
    <Opis>Lista towarów, z informacją o dacie utworzenia i ostatniej modyfikacji. Liczba wierszy towarów nie przekracza liczby podanej w parametrze. Można także podać tekst, od którego ma się zaczynać symbol asortymentu.</Opis>
    <Grupa>Asortyment</Grupa>
    <Subiekt>true</Subiekt>
    <DostepnyDlaKolumnWlasnych>false</DostepnyDlaKolumnWlasnych>
    <DostepnyDlaFiltrowWlasnych>false</DostepnyDlaFiltrowWlasnych>
    <ProfilujDane>false</ProfilujDane>
    <GlownaEncja>InsERT.Moria.ModelDanych.Asortyment</GlownaEncja>
    <EncjaZrodlowaInnaNizEncjaGlowna>false</EncjaZrodlowaInnaNizEncjaGlowna>
    <EncjaZrodlowa>
    </EncjaZrodlowa>
    <Zapytanie><![CDATA[/*
Sql zwraca krótkie info o towarach, liczba wierszy jest nie większa niż 
*/
declare @maxLiczbaWierszy INT = {I:Maksymalna liczba wierszy:15} 
declare @symbol NVARCHAR(50) = {T:Symbol zaczyna się od:}
;
with
	_data as (
select 
	a.Id, 
	row_number() over (order by a.Id) Lp,
	a.Symbol, a.Nazwa, a.Uwagi,
	ne.Utworzono [Data utworzenia], ne.Zmieniono [Data ostatniej modyfikacji]
	

from ModelDanychContainer.Asortymenty a
left join ModelDanychContainer.NaglowkiEncji ne on ne.Id = a.Naglowek_Id
)

select * from _data
where
	Lp <= @maxLiczbaWierszy
	AND Symbol LIKE @symbol + '%';
;
]]></Zapytanie>
