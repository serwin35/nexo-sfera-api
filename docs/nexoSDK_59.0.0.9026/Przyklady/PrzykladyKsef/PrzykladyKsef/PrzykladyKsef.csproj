<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <ProjectGuid>{8AFB76DE-55FC-412F-84C3-6978BC7A4215}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>PrzykladyKsef</RootNamespace>
    <AssemblyName>PrzykladyKsef</AssemblyName>
    <nexoSdkBinPath>..\..\..\Bin\</nexoSdkBinPath>
    <nexoSdkNarzedziaPath>..\..\..\Narzedzia\</nexoSdkNarzedziaPath>
    <AbsolutePathToSdkBin>$(nexoSdkBinPath)</AbsolutePathToSdkBin>
    <AbsolutePathParam>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(nexoSdkBinPath)))</AbsolutePathParam>
    <AbsolutePathToSdkBin Condition=" '$([System.IO.Path]::IsPathRooted($(nexoSdkBinPath)))' != 'true' ">$([System.IO.Path]::GetFullPath($(AbsolutePathParam)))</AbsolutePathToSdkBin>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="InsERT.Moria.API">
      <HintPath>$(nexoSdkBinPath)InsERT.Moria.API.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.ModelDanych">
      <HintPath>$(nexoSdkBinPath)InsERT.Moria.ModelDanych.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Sfera">
      <HintPath>$(nexoSdkBinPath)InsERT.Moria.Sfera.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.Core">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFramework.Core">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.EntityFramework.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFrameworkSupport">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.EntityFrameworkSupport.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Operacje\BazowaOperacja.cs" />
    <Compile Include="Operacje\GenerowanieWrazZWysylka.cs" />
    <Compile Include="Operacje\ImportEFakturyDoPrzyjecMagazynowych.cs" />
    <Compile Include="Operacje\ImportOdebranejEFaktury.cs" />
    <Compile Include="Operacje\OdbiorDokumentowZOkresu.cs" />
    <Compile Include="Operacje\OdbiorNowychDokumentow.cs" />
    <Compile Include="Operacje\OdbiorPojedynczegoDokumentu.cs" />
    <Compile Include="Operacje\PobieranieUPO.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Pomocnicze\Helpers.cs" />
    <Compile Include="Pomocnicze\Uchwyty.cs" />
    <Compile Include="Pomocnicze\PostepLadowaniaSfery.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Operacje\WysylkaPoZapisieDokumentu.cs" />
    <Compile Include="Operacje\WysylkaZbiorcza.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Konfiguracja.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="ParametryInstalacji.txt" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /y &quot;$(AbsolutePathToSdkBin)Xml.pak&quot; &quot;$(TargetDir)\Xml.pak&quot;" />
    <Exec Command="copy /y &quot;$(nexoSdkBinPath)sni.dll&quot; &quot;$(TargetDir)sni.dll&quot;" />
    <Exec Command="copy /y &quot;$(nexoSdkBinPath)ijwhost.dll&quot; &quot;$(TargetDir)ijwhost.dll&quot;" />
    <Exec Command="copy /y &quot;$(nexoSdkBinPath)Microsoft.Data.SqlClient.SNI.dll&quot; &quot;$(TargetDir)Microsoft.Data.SqlClient.SNI.dll&quot;" />
    <Exec Command="if exist &quot;$(nexoSdkNarzedziaPath)PackageAndInstallerBuilder.exe&quot; (call &quot;$(nexoSdkNarzedziaPath)PackageAndInstallerBuilder.exe&quot; /PlikKonfiguracji:Konfiguracja.xml /KatalogDocelowy:&quot;$(TargetDir)\&quot;) else (echo Nie można zbudować pakietu i instalatora, ponieważ nie istnieje plik: &quot;$(nexoSdkNarzedziaPath)PackageAndInstallerBuilder.exe&quot;)" />
  </Target>
</Project>