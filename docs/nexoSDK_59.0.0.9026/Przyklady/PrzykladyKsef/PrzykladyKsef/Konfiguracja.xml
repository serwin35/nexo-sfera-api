        <File Name="PrzykladyKsef.exe" />
        <File Name="PrzykladyKsef.dll" />
        <File Name="PrzykladyKsef.runtimeconfig.json" />
      </Contents>
      <LaunchScenarios>
        <LaunchScenario Name="PrzykladyKsef" CanUpdate="false">
          <LaunchAction ExePath="PrzykladyKsef.exe" CommandLineArguments="/UruchomionePrzezInsLauncher" RedirectedInput="!LauncherMessageFormatB!" RedirectedInputEncoding="utf-8" />
        </LaunchScenario>
      </LaunchScenarios>
      <DeployActions />
      <Dependencies>
