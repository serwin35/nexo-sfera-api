  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /y &quot;$(AbsolutePathToSdkBin)Xml.pak&quot; &quot;$(TargetDir)\Xml.pak&quot;" />
    <Exec Command="copy /y &quot;$(nexoSdkBinPath)sni.dll&quot; &quot;$(TargetDir)sni.dll&quot;" />
