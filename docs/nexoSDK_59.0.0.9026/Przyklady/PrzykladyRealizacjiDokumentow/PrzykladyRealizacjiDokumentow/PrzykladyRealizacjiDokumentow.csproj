    <Reference Include="InsERT.Mox.EntityFrameworkSupport">
      <HintPath>$(nexoSdkBinPath)InsERT.Mox.EntityFrameworkSupport.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Helpers.cs" />
    <Compile Include="Przyklady\FakturaDetalicznaNaPodstawieParagonu.cs" />
    <Compile Include="Przyklady\FakturowaniePrzyjec.cs" />
