<Window x:Class="PrzepisywaniePowiazanWiadomosci.LaczenieZeSferaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Trwa łączenie ze Sferą..." Height="250" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="#eaeeee"
        WindowStartupLocation="CenterScreen">
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="200"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <Label Grid.Row="0" Content="Trwa łączenie ze Sferą i pobieranie kont pocztowych..."
           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#1198bd"/>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="10"/>
  </Grid>
</Window>
