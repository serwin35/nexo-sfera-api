<Window x:Class="GeneratorDanych.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeneratorDanych"
		xmlns:converters="clr-namespace:GeneratorDanych.Converters"
        mc:Ignorable="d"        
        Title="Sferyczny generator danych" SizeToContent="Height" Width="1000"
		WindowStartupLocation="CenterScreen"
		FontSize="16" >

	<Window.Resources>

		<SolidColorBrush x:Key="MainColorLight" Color="#e6e6fa"  />
		<SolidColorBrush x:Key="MainColorDark" Color="#4707ad" />

		<converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converters:NegateBooleanConverter x:Key="NegateBooleanConverter" />
		<converters:BooleanAndConverter x:Key="BooleanAndConverter" />

		<Style x:Key="FormLabel" TargetType="{x:Type TextBlock}">
			<Setter Property="Margin" Value="4" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="TextWrapping" Value="WrapWithOverflow" />
		</Style>

		<Style x:Key="FormTextInput" TargetType="{x:Type TextBox}">
			<Setter Property="Margin" Value="4" />
			<Setter Property="Padding" Value="4" />
		</Style>

		<Style x:Key="FormButton" TargetType="{x:Type Button}">
			<Setter Property="Margin" Value="4 10" />
			<Setter Property="Padding" Value="8 4" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="MinWidth" Value="90" />
			<Setter Property="BorderBrush" Value="#ababab" />
			
		</Style>

		<Style x:Key="AppTitle" TargetType="{x:Type TextBlock}">
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="20 10 4 10" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="TextWrapping" Value="WrapWithOverflow" />
			<Setter Property="Foreground" Value="{DynamicResource MainColorDark}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="FormHeader" TargetType="{x:Type TextBlock}">
			<Setter Property="Margin" Value="6 4 4 0" />
			<Setter Property="Padding" Value="4 4 4 0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="TextWrapping" Value="WrapWithOverflow" />
			<Setter Property="Foreground" Value="{DynamicResource MainColorDark}" />
		</Style>

		<Style x:Key="SectionBorder" TargetType="{x:Type Border}">
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{DynamicResource MainColorLight}" />
			<Setter Property="Padding" Value="2" />
			<Setter Property="Margin" Value="10 2 10 4" />
		</Style>

		<Style x:Key="StatsTableHeader" TargetType="{x:Type TextBlock}" >
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="TextWrapping" Value="WrapWithOverflow" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="Background" Value="WhiteSmoke" />
		</Style>
		
		<Style x:Key="StatsTableBorder" TargetType="{x:Type Border}" >
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="WhiteSmoke" />
		</Style>
		<Style x:Key="StatsTableData" TargetType="{x:Type TextBlock}" >
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="TextWrapping" Value="WrapWithOverflow" />
			<Setter Property="TextAlignment" Value="Right" />
		</Style>

	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*" />
			<ColumnDefinition Width="3*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<DockPanel Background="{DynamicResource MainColorLight}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
			<TextBlock Padding="4 4" Margin="0 0 4 0" FontSize="12" 
					   VerticalAlignment="Center"
					DockPanel.Dock="Right">
				<Run Text="Wersja Sfery:" />
				<Run Text="{Binding WersjaSfery, Mode=OneTime}" d:Text="99.9.9.999" />
				<LineBreak /> 
				<Run Text=".NET" />
				<Run Text="{Binding WersjaDotnet, Mode=OneTime}" d:Text="4.0.0000.0" />
			</TextBlock>

			<TextBlock DockPanel.Dock="Left" Text="SFERYCZNY GENERATOR DANYCH"
					   Style="{DynamicResource AppTitle}"/>
		</DockPanel>

		<StackPanel Grid.Column="0" Grid.Row="1">
			<TextBlock Text="POŁĄCZENIE Z BAZĄ"
				   Style="{DynamicResource FormHeader}"/>
			<Border Style="{DynamicResource SectionBorder}">
				<Grid Margin="4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Text="Serwer SQL:" 
						   Grid.Column="0"
						   Grid.Row="0"
						   Style="{DynamicResource FormLabel}" />

					<TextBox Grid.Column="1"
						 Grid.Row="0"
						 Style="{DynamicResource FormTextInput}"
						 Text="{Binding SerwerSql, Mode=TwoWay}"
						 IsEnabled="{Binding EdytowalneDanePolaczenia, Mode=OneWay}"/>

					<TextBlock Text="Baza danych:" 
						   Grid.Column="0"
						   Grid.Row="1"
						   Style="{DynamicResource FormLabel}"/>

					<TextBox Grid.Column="1"
						 Grid.Row="1"
						 Style="{DynamicResource FormTextInput}"
						 Text="{Binding BazaDanych, Mode=TwoWay}"
						 IsEnabled="{Binding EdytowalneDanePolaczenia, Mode=OneWay}"/>

					<CheckBox x:Name="CheckBoxIntegratedSecurity"
						  Content="Uwierzytelnienie Windows"
						  Grid.Column="0"
						  Grid.ColumnSpan="2"
						  Grid.Row="2" 
						  Margin="14 4 4 4" Padding="4"
						  VerticalContentAlignment="Center" 
						  IsChecked="{Binding UwierzytelnienieWindows}"
						  IsEnabled="{Binding EdytowalneDanePolaczenia, Mode=OneWay}"/>

					<TextBlock Text="Login do serwera SQL:" 
						   Grid.Column="0"
						   Grid.Row="3"
						   Style="{DynamicResource FormLabel}"/>

					<TextBox Grid.Column="1"
						 Grid.Row="3"
						 Style="{DynamicResource FormTextInput}"
						 Text="{Binding LoginSql, Mode=TwoWay}">
						<TextBox.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding ElementName="CheckBoxIntegratedSecurity" Path="IsChecked" Converter="{StaticResource NegateBooleanConverter}" />
								<Binding Path="EdytowalneDanePolaczenia"  />
							</MultiBinding>
						</TextBox.IsEnabled>
					</TextBox>

					<TextBlock Text="Hasło do serwera SQL:" 
						   Grid.Column="0"					
						   Grid.Row="4"
						   Style="{DynamicResource FormLabel}"/>

					<PasswordBox x:Name="PasswordBoxSqlServer"
							 Grid.Column="1"
							 Grid.Row="4"
							 Margin="4" Padding="4">
						<PasswordBox.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding ElementName="CheckBoxIntegratedSecurity" Path="IsChecked" Converter="{StaticResource NegateBooleanConverter}" />
								<Binding Path="EdytowalneDanePolaczenia"  />
							</MultiBinding>
						</PasswordBox.IsEnabled>
					</PasswordBox>

					<Button	x:Name="ButtonGetUsers"
						Grid.Column="0" Grid.ColumnSpan="2"
						Grid.Row="6"  
						Style="{DynamicResource FormButton}"
						Content="Pobierz użytkowników"
						Click="ButtonGetUsers_Click"
						IsEnabled="{Binding EdytowalneDanePolaczenia, Mode=OneWay}" />
				</Grid>
			</Border>


			<TextBlock Text="LOGOWANIE DO NEXO"
				   Style="{DynamicResource FormHeader}"/>
			<Border Style="{DynamicResource SectionBorder}">
				<Grid Margin="10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Text="Login nexo:" 
						   Grid.Column="0"
						   Grid.Row="0"
						   Style="{DynamicResource FormLabel}" />

					<ComboBox Grid.Column="1"
						  Grid.Row="0"
						  Margin="4" Padding="4"
						  ItemsSource="{Binding Uzytkownicy, Mode=OneWay}"
						  SelectedValue="{Binding LoginNexo}"
						  IsEnabled="{Binding GotowyDoLogowania, Mode=OneWay}">
					</ComboBox>

					<TextBlock Text="Hasło nexo:" 
						   Grid.Column="0"
						   Grid.Row="1"
						   Style="{DynamicResource FormLabel}"/>

					<PasswordBox x:Name="PasswordBoxNexo" 
							 Grid.Column="1"
							 Grid.Row="1"
							 Margin="4" Padding="4"
							 IsEnabled="{Binding GotowyDoLogowania, Mode=OneWay}"/>


					<Button x:Name="ButtonLogin"
						Grid.Column="0" Grid.ColumnSpan="2"
						Grid.Row="2"  
						Style="{DynamicResource FormButton}"
						Content="Zaloguj do nexo"
						Click="ButtonLogin_Click"
						IsEnabled="{Binding GotowyDoLogowania, Mode=OneWay}">
					</Button>
				</Grid>

			</Border>

			<TextBlock Text="DODAWANIE ZAMÓWIEŃ"
				   Style="{DynamicResource FormHeader}"/>
			<Border Style="{DynamicResource SectionBorder}">
				<UniformGrid Columns="3">

					<Button x:Name="ButtonAddDocuments_1"
							Style="{DynamicResource FormButton}"
							Content="Dodaj 1" VerticalAlignment="Center"
							Grid.Column="0"
							Click="ButtonAddDocuments_1_Click">
						<Button.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding Path="CzySferaJestUruchomiona" />
								<Binding Path="CzyTrwaDodawanieZamowien" Converter="{StaticResource NegateBooleanConverter}" />
							</MultiBinding>
						</Button.IsEnabled>
					</Button>

					<Button x:Name="ButtonAddDocuments_10"
							Style="{DynamicResource FormButton}"
							Content="Dodaj 10" VerticalAlignment="Center"
							Grid.Column="1"
							Click="ButtonAddDocuments_10_Click">
						<Button.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding Path="CzySferaJestUruchomiona" />
								<Binding Path="CzyTrwaDodawanieZamowien" Converter="{StaticResource NegateBooleanConverter}" />
							</MultiBinding>
						</Button.IsEnabled>
					</Button>

					<Button x:Name="ButtonAddDocuments_100"
							Style="{DynamicResource FormButton}"
							Content="Dodaj 100" VerticalAlignment="Center"
							Grid.Column="2"
							Click="ButtonAddDocuments_100_Click">
						<Button.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding Path="CzySferaJestUruchomiona" />
								<Binding Path="CzyTrwaDodawanieZamowien" Converter="{StaticResource NegateBooleanConverter}" />
							</MultiBinding>
						</Button.IsEnabled>
					</Button>

				</UniformGrid>
			</Border>

			<TextBlock Text="DODAWANIE TOWARÓW"
				   Style="{DynamicResource FormHeader}"/>
			<Border Style="{DynamicResource SectionBorder}">
				<UniformGrid Columns="3">

					<Button x:Name="ButtonAddItems_1"
							Style="{DynamicResource FormButton}"
							Content="Dodaj 1" VerticalAlignment="Center"
							Grid.Column="0"
							Click="ButtonAddItems_1_Click">
						<Button.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding Path="CzySferaJestUruchomiona" />
								<Binding Path="CzyTrwaDodawanieTowarow" Converter="{StaticResource NegateBooleanConverter}" />
							</MultiBinding>
						</Button.IsEnabled>
					</Button>

					<Button x:Name="ButtonAddItems_10"
							Style="{DynamicResource FormButton}"
							Content="Dodaj 10" VerticalAlignment="Center"
							Grid.Column="1"
							Click="ButtonAddItems_10_Click">
						<Button.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding Path="CzySferaJestUruchomiona" />
								<Binding Path="CzyTrwaDodawanieTowarow" Converter="{StaticResource NegateBooleanConverter}" />
							</MultiBinding>
						</Button.IsEnabled>
					</Button>

					<Button x:Name="ButtonAddItems_100"
							Style="{DynamicResource FormButton}"
							Content="Dodaj 100" VerticalAlignment="Center"
							Grid.Column="2"
							Click="ButtonAddItems_100_Click">
						<Button.IsEnabled>
							<MultiBinding Converter="{StaticResource BooleanAndConverter}" Mode="OneWay">
								<Binding Path="CzySferaJestUruchomiona" />
								<Binding Path="CzyTrwaDodawanieTowarow" Converter="{StaticResource NegateBooleanConverter}" />
							</MultiBinding>
						</Button.IsEnabled>
					</Button>
				</UniformGrid>
			</Border>
		</StackPanel>

		<DockPanel Grid.Column="1" Grid.Row="1">
			<TextBlock Text="PRZEBIEG OPERACJI"
					   Style="{DynamicResource FormHeader}"
					   DockPanel.Dock="Top"/>
			<Border Style="{DynamicResource SectionBorder}" DockPanel.Dock="Top">
				<DockPanel Grid.Column="1" Grid.Row="1" Margin="0">
					
					<Grid DockPanel.Dock="Top" Margin="20 14 20 4">
						<Grid.ColumnDefinitions>							
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock Grid.Column="1" Grid.Row="0" 
								   Style="{DynamicResource StatsTableHeader}"
								   Text="Dodawanie zamówień" />
						<TextBlock Grid.Column="2" Grid.Row="0" 
								   Style="{DynamicResource StatsTableHeader}"
								   Text="Dodawanie towarów" />

						<TextBlock Grid.Column="0" Grid.Row="1" 
								   Text="Ile pomiarów" 
								   Style="{DynamicResource StatsTableHeader}"
								   TextAlignment="Left"/>
						<TextBlock Grid.Column="0" Grid.Row="2" 
								   Text="Średni czas operacji [s]" 
								   Style="{DynamicResource StatsTableHeader}"
								   TextAlignment="Left"/>
						<TextBlock Grid.Column="0" Grid.Row="3" 
								   Text="Ile operacji na minutę" 
								   Style="{DynamicResource StatsTableHeader}"
								   TextAlignment="Left"/>

						<Border Grid.Column="1" Grid.Row="1" 
								Style="{DynamicResource StatsTableBorder}">
							<TextBlock Style="{DynamicResource StatsTableData}"
									   Text="{Binding IleZamowienZmierzono, Mode=OneWay}"/>
						</Border>						
						<Border Grid.Column="1" Grid.Row="2"
								Style="{DynamicResource StatsTableBorder}">
							<TextBlock Grid.Column="1" Grid.Row="2" 
								   Style="{DynamicResource StatsTableData}"
								   Text="{Binding IleCzasuNaZamowienie, Mode=OneWay, StringFormat=\{0:N3\}}"/>
						</Border>
						<Border Grid.Column="1" Grid.Row="3"
								Style="{DynamicResource StatsTableBorder}">
							<TextBlock Grid.Column="1" Grid.Row="3" 
								   Style="{DynamicResource StatsTableData}"
								   Text="{Binding IleZamowienNaMinute, Mode=OneWay}"/>
						</Border>
						
						<Border Grid.Column="2" Grid.Row="1"
								Style="{DynamicResource StatsTableBorder}">
							<TextBlock Style="{DynamicResource StatsTableData}"
								   Text="{Binding IleTowarowZmierzono, Mode=OneWay}"/>
						</Border>
						<Border Grid.Column="2" Grid.Row="2" 
								Style="{DynamicResource StatsTableBorder}">	
							<TextBlock Style="{DynamicResource StatsTableData}"
								   Text="{Binding IleCzasuNaTowar, Mode=OneWay, StringFormat=\{0:N3\}}"/>
						</Border>
						<Border Grid.Column="2" Grid.Row="3"
								Style="{DynamicResource StatsTableBorder}">
							<TextBlock Style="{DynamicResource StatsTableData}"
									   Text="{Binding IleTowarowNaMinute, Mode=OneWay}"/>
						</Border>
					</Grid>

					<Button x:Name="ButtonExportStats" 
							DockPanel.Dock="Top"
							Style="{DynamicResource FormButton}"
							Content="Eksportuj wyniki" 
							Click="ButtonExportStats_Click"	/>

					<Button x:Name="ButtonClearLog" 
							DockPanel.Dock="Bottom"
							Style="{DynamicResource FormButton}"
							Content="Wyczyść historię operacji" 
							Click="ButtonClearLog_Click"/>

					<ScrollViewer Margin="0 10 0 0" DockPanel.Dock="Bottom" MaxHeight="362" 
								  x:Name="ScrollOperations">
						<ItemsControl ItemsSource="{Binding LogOperacji.Operacje}"
									  Padding="4 0">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}" Margin="0 1" Padding="4 2" 
											   TextWrapping="WrapWithOverflow" 
											   Background="WhiteSmoke"
											   Foreground="#484848"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

				</DockPanel>
			</Border>
		</DockPanel>

		<Grid Margin="10" Height="25" Grid.Row="2" Grid.ColumnSpan="2">
			<ProgressBar Visibility="{Binding CzyTrwaOperacja, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Hidden}"
						 IsIndeterminate="{Binding PostepOperacji.CzyMaProcent, Converter={StaticResource NegateBooleanConverter}}"
						 Minimum="0" Maximum="100" 
						 Value="{Binding PostepOperacji.BiezacyProcent}"
						 Background="#e1ebe4" />

			<TextBlock Visibility="{Binding CzyTrwaOperacja, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Hidden}"
					   Text="{Binding PostepOperacji.Opis}" 
					   FontSize="12" 
					   Padding="4" 
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center" />
		</Grid>

	</Grid>

	


</Window>
