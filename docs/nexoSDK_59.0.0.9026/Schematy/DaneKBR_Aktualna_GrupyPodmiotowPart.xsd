<?xml version="1.0" encoding="utf-8"?>
<!-- Uzyj xsd.exe do wygenerowania z tego kodu -->
<xs:schema 
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified" 
  xmlns="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania" 
  targetNamespace="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania" 
  id="DaneKBR">
  <xs:annotation>
    <xs:documentation>Dane grup podmiotów.</xs:documentation>
  </xs:annotation>
  
  <!-- TODO ustalić wymagalność pól -->
  <!-- xsd z definiowanymi typami danych -->
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  <!-- Grupy podmiotów  -->
  <xs:complexType name="TGrupaPodmiotow">
    <xs:annotation>
      <xs:documentation>Obiekt grupy podmiotów.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Id" type="xs:ID" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator jednoznacznie identyfikujący w ramach pliku XML dla grupy podmiotów.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="BId" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator bazodanowy grupy podmiotów.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Nazwa" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Nazwa grupy podmiotów.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ParentNazwa" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Nieużywane.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Typ" type="xs:int" use="optional">
      <xs:annotation>
        <xs:documentation>Typ podmiotu (0 - wszyscy, 1 - osoba, 2 - firma, 3 - pracownik).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="PodmiotId" type="xs:IDREF" use="optional">
      <xs:annotation>
        <xs:documentation>Identyfikator podmiotu.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="TGrupyPodmiotow">
    <xs:annotation>
      <xs:documentation>Kolekcja grup podmiotów.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="GrupaPodmiotow" type="TGrupaPodmiotow" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Grupa podmiotów.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>