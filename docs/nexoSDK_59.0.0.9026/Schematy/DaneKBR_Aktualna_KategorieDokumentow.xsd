<?xml version="1.0" encoding="utf-8"?>
<xs:schema 
  id="Dane_KategorieDokumentowPart" 
  elementFormDefault="qualified"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania" 
  targetNamespace="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania">
  <xs:annotation>
    <xs:documentation>Dane kategorii dokumentów.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  
  <xs:complexType name="TKategoriaDokumentu">
    <xs:annotation>
      <xs:documentation>Obiekt kategorii dokumentu.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Nazwa" type="xs:string">
      <xs:annotation>
        <xs:documentation>Nazwa kategorii dokumentu.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Podtytul" type="xs:string">
      <xs:annotation>
        <xs:documentation>Podtytuł kategorii dokumentu.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Id" type="xs:ID" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator jednoznacznie identyfikujący w ramach pliku XML dla kategorii dokumentu.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="BId" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator bazodanowy kategorii dokumentu.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="TKategorieDokumentow">
    <xs:annotation>
      <xs:documentation>Kolekcja kategorii dokumentów.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="KategoriaDokumentu" type="TKategoriaDokumentu" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Kategoria dokumentu.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>