<?xml version="1.0" encoding="utf-8"?>
<xs:schema 
  id="Dane_StanowiskaKasowe" 
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania" 
  targetNamespace="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania">
  <xs:annotation>
    <xs:documentation>Dane kas fiskalnych i stanowisk kasowych.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  
  <!--Slownik kasy -->
  <xs:complexType name="TKasa">
    <xs:annotation>
      <xs:documentation>Obiekt kasy fiskalnej.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Id" type="xs:ID" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator jednoznacznie identyfikujący w ramach pliku XML dla kasy fiskalnej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="BId" type="xs:int" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator bazodanowy kasy fiskalnej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Symbol" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Symbol kasy fiskalnej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Opis" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Opis kasy fiskalnej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Nazwa" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Nazwa kasy fiskalnej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="TKasy">
    <xs:annotation>
      <xs:documentation>Kolekcja kas fiskalnej.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Kasa" type="TKasa" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Kasa fiskalna.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <!--Slownik Stanowisko kasowe -->
  <xs:complexType name="TStanowiskoKasowe">
    <xs:annotation>
      <xs:documentation>Obiekt stanowiska kasowego.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Id" type="xs:ID" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator jednoznacznie identyfikujący w ramach pliku XML dla stanowiska kasowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="BId" type="xs:int" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator bazodanowy stanowiska kasowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Symbol" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Symbol stanowiska kasowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Opis" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Opis stanowiska kasowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Nazwa" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Nazwa stanowiska kasowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KasaId" type="xs:IDREF" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator kasy fiskalnej przypisanej do danego stanowiska kasowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="TStanowiskaKasowe">
    <xs:annotation>
      <xs:documentation>Kolekcja stanowisk kasowych.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="StanowiskoKasowe" type="TStanowiskoKasowe" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Stanowisko kasowe.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>