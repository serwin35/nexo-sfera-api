<?xml version="1.0" encoding="utf-8"?>
<!-- Uzyj xsd.exe do wygenerowania z tego kodu -->
<xs:schema 
  xmlns:xs="http://www.w3.org/2001/XMLSchema" 
  elementFormDefault="qualified" 
  xmlns="http://schemas.insert.com.pl/2020/dokumentyDoKsiegowania/bank" 
  targetNamespace="http://schemas.insert.com.pl/2020/dokumentyDoKsiegowania/bank"
  xmlns:ddk="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania">  
  <xs:annotation>
    <xs:documentation>Dane operacji bankowej.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  <xs:import id="PolaWlasnePart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./Dane_2012_PolaWlasnePart.xsd" />
  
  <xs:complexType name="TNaglowekOperacjiBankowej">
    <xs:annotation>
      <xs:documentation>Zbiór pól nagłówkowych operacji bankowej.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="KolekcjePolWlasnych" type="ddk:TKolekcjePolWlasnych" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Zbiór pól własnych operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Data" type="xs:date" nillable="false">
        <xs:annotation>
          <xs:documentation>Data księgowania operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataEfektywna" type="xs:date" nillable="true">
        <xs:annotation>
          <xs:documentation>Data operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Podmiot" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Podmiot operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PodmiotAdresHistoria" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Adres podmiotu operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Kwota" type="xs:decimal" nillable="false">
        <xs:annotation>
          <xs:documentation>Kwota operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Tytulem" type="xs:string" nillable="true">
        <xs:annotation>
          <xs:documentation>Pole tytułem operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="NrWyciagu" type="xs:string" nillable="true">
        <xs:annotation>
          <xs:documentation>Numer wyciagu bankowego, na którym znajduje się dana operacja.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="NrPozycjiWWyciagu" type="xs:int" nillable="true">
        <xs:annotation>
          <xs:documentation>Numer pozycji na wyciagu bankowym, na którym znajduje się dana operacja.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Wplyw" type="xs:boolean" nillable="false">
        <xs:annotation>
          <xs:documentation>Czy operacja bankowa jest wpłatą.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Transfer" type="xs:boolean" nillable="false">
        <xs:annotation>
          <xs:documentation>Czy operacja bankowa jest transferem.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="RachunekNadawcy" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Rachunek nadawcy operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="FormaPlatnosci" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Forma płatności.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="IdDokumentuRozliczanego" type="xs:string" nillable="true">
        <xs:annotation>
          <xs:documentation>Identyfikator dokumentu rozliczanego przez operację bankową.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="RodzajOperacji" type="ddk:TPositiveInt" nillable="false">
        <xs:annotation>
          <xs:documentation>Rodzaj  operacji bankowej (1 - przelew, 2 - gotówka, 3 - karta, 4 - pozostałe operacje, 5 - tranfer).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TypRozrachunku" type="xs:unsignedByte" nillable="true">
        <xs:annotation>
          <xs:documentation>Typ rozrachunku powiązanego z operacją bankową (1 - należność, 2 - zobowiązanie).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="Waluta" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Waluta operacji bankowej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="RodzajRozrachunku" type="ddk:TGuid" use="optional">
      <xs:annotation>
        <xs:documentation>Rodzaj rozrachunku powiązanego z operacją bankową (identyfikator obiektu ze słownika).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="TypDokumentuRozliczanego" type="ddk:TGuid" use="optional">
      <xs:annotation>
        <xs:documentation>Identyfikator typu dokumentu rozliczanego przez operację bankową.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="NumerDokumentuRozliczanego" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Numer dokumentu rozliczanego przez operację bankową.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="GrupaPodmiotu" type="ddk:TPositiveInt" use="optional">
      <xs:annotation>
        <xs:documentation>Grupa podmiotu.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="TytulemZRozrachunku" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Tytułem z rozrachunku.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaVAT" type="xs:decimal" use="optional">
      <xs:annotation>
        <xs:documentation>Kwota VAT.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaZRachunkuVAT" type="xs:decimal" use="optional">
      <xs:annotation>
        <xs:documentation>Kwota z rachunku VAT.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="TypTransferuVAT" type="xs:unsignedByte" use="optional">
      <xs:annotation>
        <xs:documentation>Typ transferu VAT.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Opis" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Tytułem z rozrachunku.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
	<xs:attribute name="Wrazliwa" type="xs:boolean" use="optional">
        <xs:annotation>
		    <xs:documentation>Operacja wrażliwa.</xs:documentation>
	    </xs:annotation>
	 </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="TOperacjaBankowa">
    <xs:annotation>
      <xs:documentation>Operacja bankowa wraz z wersją schematu.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Wersja" type="xs:string" nillable="false" fixed="2020">
        <xs:annotation>
          <xs:documentation>Wersja schematu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Naglowek" type="TNaglowekOperacjiBankowej" nillable="false">
        <xs:annotation>
          <xs:documentation>Nagłówek operacji bankowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:element name="Dokument" type="TOperacjaBankowa">
    <xs:annotation>
      <xs:documentation>Główny węzeł opakowujący operację bankową.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>