<?xml version="1.0" encoding="utf-8"?>
<!-- Uzyj xsd.exe do wygenerowania z tego kodu -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
           elementFormDefault="qualified" 
           xmlns="http://schemas.insert.com.pl/2020/dokumentyDoKsiegowania/rozrachunki" 
           targetNamespace="http://schemas.insert.com.pl/2020/dokumentyDoKsiegowania/rozrachunki" 
           xmlns:ddk="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania">
  <xs:annotation>
    <xs:documentation>Dane korekty podstawy opodatkowania niezapłaconego dokumentu.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  <xs:import id="PolaWlasnePart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./Dane_2012_PolaWlasnePart.xsd" />
  
  <xs:complexType name="TNaglowekKorektyPodstawyOpodatkowaniaNiezaplaconegoDokumentu">
    <xs:annotation>
      <xs:documentation>Zbiór pól nagłówkowych korekty podstawy opodatkowania niezapłaconego dokumentu.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="KolekcjePolWlasnych" type="ddk:TKolekcjePolWlasnych" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Zbiór pól własnych korekty podstawy opodatkowania niezapłaconego dokument.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="Waluta" type="ddk:TGuid" use="required">
      <xs:annotation>
        <xs:documentation>Waluta korekty.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="PodmiotHistoria" type="ddk:TPositiveInt" use="optional">
      <xs:annotation>
        <xs:documentation>Identyfikator podmiotu na korekcie.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="DataNaliczenia" type="xs:date" use="required">
      <xs:annotation>
        <xs:documentation>Data naliczenia korekty.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="TerminPlatnosci" type="xs:date" use="optional">
      <xs:annotation>
        <xs:documentation>Termin płatności korekty.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaBrutto" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Kwota brutto pierwotnego dokumentu źródłowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaNetto" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Kwota netto pierwotnego dokumentu źródłowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaVAT" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Kwota VAT pierwotnego dokumentu źródłowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaNierozliczonaBrutto" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Kwota nierozliczona brutto.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaNierozliczonaNetto" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Kwota nierozliczona netto.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaNierozliczonaVAT" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Kwota nierozliczona VAT.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="KwotaKorekty" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Kwota korekty.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="DokumentZrodlowy" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Dokument źródłowy</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="DataDokumentuZrodlowego" type="xs:date" use="required">
      <xs:annotation>
        <xs:documentation>Data dokumentu źródłowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="IdDokumentuDoKsiegowaniaDokumentuZrodlowego" type="ddk:TGuid" use="optional">
      <xs:annotation>
        <xs:documentation>Id dokumentu do dekretacji dokumentu źródłowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="TKorektaPodstawyOpodatkowaniaNiezaplaconegoDokumentu">
    <xs:annotation>
      <xs:documentation>Korekta podstawy opodatkowania niezapłaconego dokumentu wraz z wersją schematu.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Wersja" type="xs:string" nillable="false" fixed="2020">
        <xs:annotation>
          <xs:documentation>Wersja schematu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Naglowek" type="TNaglowekKorektyPodstawyOpodatkowaniaNiezaplaconegoDokumentu" nillable="false">
        <xs:annotation>
          <xs:documentation>Nagłówek korekty podstawy opodatkowania niezapłaconego dokumentu.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:element name="Dokument" type="TKorektaPodstawyOpodatkowaniaNiezaplaconegoDokumentu">
    <xs:annotation>
      <xs:documentation>Główny węzeł opakowujący korektę podstawy opodatkowania niezapłaconego dokumentu.</xs:documentation>
    </xs:annotation>
  </xs:element>
  
</xs:schema>