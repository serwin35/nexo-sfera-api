<?xml version="1.0" encoding="utf-8"?>
<!-- Uzyj xsd.exe do wygenerowania z tego kodu -->
<xs:schema 
  xmlns:xs="http://www.w3.org/2001/XMLSchema" 
  elementFormDefault="qualified" 
  xmlns="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania/bank" 
  targetNamespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania/bank" 
  xmlns:ddk="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania">
  <xs:annotation>
    <xs:documentation>Dane wyciągu bankowego.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  <xs:import id="PolaWlasnePart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./Dane_2012_PolaWlasnePart.xsd" />
  
  <xs:complexType name="TNaglowekWyciaguBankowego">
    <xs:annotation>
      <xs:documentation>Zbiór pól nagłówkowych wyciągu bankowego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="KolekcjePolWlasnych" type="ddk:TKolekcjePolWlasnych" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Zbiór pól własnych wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Numer" type="xs:string" nillable="false">
        <xs:annotation>
          <xs:documentation>Numer wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Data" type="xs:date" nillable="true">
        <xs:annotation>
          <xs:documentation>Data wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="OkresOd" type="xs:date" nillable="false">
        <xs:annotation>
          <xs:documentation>Pierwszy dzień okresu, który obejmuje wyciąg bankowy.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="OkresDo" type="xs:date" nillable="false">
        <xs:annotation>
          <xs:documentation>Ostatni dzień okresu, który obejmuje wyciąg bankowy.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Rachunek" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Rachunek wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Status" type="xs:unsignedByte" nillable="false">
        <xs:annotation>
          <xs:documentation>Status wyciągu bankowego (0 - odłożony, 1 - wykonany).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SaldoPoczatkowe" type="xs:decimal" nillable="false">
        <xs:annotation>
          <xs:documentation>Saldo początkowe wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SumaUznan" type="xs:decimal" nillable="false">
        <xs:annotation>
          <xs:documentation>Uznania (suma) wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SumaObciazen" type="xs:decimal" nillable="false">
        <xs:annotation>
          <xs:documentation>Obciążenia (suma) wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SaldoKoncowe" type="xs:decimal" nillable="false">
        <xs:annotation>
          <xs:documentation>Saldo końcowe wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="Waluta" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Waluta wyciągu bankowego.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="TPozycjaWyciaguBankowego">
    <xs:annotation>
      <xs:documentation>Pozycja wyciągu bankowego odpowiadająca danej operacji bankowej.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="LiczbaPorzadkowa" type="xs:int" nillable="false">
        <xs:annotation>
          <xs:documentation>Liczba porządkowa pozycji wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KolekcjePolWlasnych" type="ddk:TKolekcjePolWlasnych" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Zbiory pól własnych dla operacji bankowych.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="DokumentDoKsiegowaniaId" type="ddk:TGuid" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator dokumentu do księgowania operacji bankowej odpowiadającej danej pozycji.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="TPozycjeWyciaguBankowego">
    <xs:annotation>
      <xs:documentation>Kolekcja pozycji wyciągu bankowego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Pozycja" type="TPozycjaWyciaguBankowego">
        <xs:annotation>
          <xs:documentation>Węzeł pozycji wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="TWyciagBankowy">
    <xs:annotation>
      <xs:documentation>Wyciąg bankowy wraz z wersją schematu.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Wersja" type="xs:string" nillable="false" fixed="2012">
        <xs:annotation>
          <xs:documentation>Wersja schematu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Naglowek" type="TNaglowekWyciaguBankowego" nillable="false">
        <xs:annotation>
          <xs:documentation>Naglowek wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Pozycje" type="TPozycjeWyciaguBankowego" nillable="true">
        <xs:annotation>
          <xs:documentation>Kolekcja pozycji wyciągu bankowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:element name="Dokument" type="TWyciagBankowy">
    <xs:annotation>
      <xs:documentation>Główny węzeł opakowujący wyciąg bankowy.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>