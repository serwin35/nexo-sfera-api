<?xml version="1.0" encoding="utf-8"?>
<!-- Uzyj xsd.exe do wygenerowania z tego kodu -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
           elementFormDefault="qualified" 
           xmlns="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania/kasa" 
           targetNamespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania/kasa"
           xmlns:ddk="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania">
  <xs:annotation>
    <xs:documentation>Dane raportu kasowego.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  <xs:import id="PolaWlasnePart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./Dane_2012_PolaWlasnePart.xsd" />
  
  <xs:complexType name="TNaglowekRaportuKasowego">
    <xs:annotation>
      <xs:documentation>Zbiór pól nagłówkowych raportu kasowego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Numer" type="xs:string" nillable="false">
        <xs:annotation>
          <xs:documentation>Numer raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataOd" type="xs:date" nillable="false">
        <xs:annotation>
          <xs:documentation>Pierwszy dzień okresu, który obejmuje raport kasowy.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataDo" type="xs:date" nillable="true">
        <xs:annotation>
          <xs:documentation>Ostatni dzień okresu, który obejmuje raport kasowy.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Kasa" type="ddk:TPositiveInt" nillable="false">
        <xs:annotation>
          <xs:documentation>Kasa</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Obciazenia" type="xs:decimal" nillable="true">
        <xs:annotation>
          <xs:documentation>Obciążenia (suma) raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Uznania" type="xs:decimal" nillable="true">
        <xs:annotation>
          <xs:documentation>Uznania (suma) raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KolekcjePolWlasnych" type="ddk:TKolekcjePolWlasnych" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Zbiór pól własnych raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="TPozycjaRaportuKasowego">
    <xs:annotation>
      <xs:documentation>Pozycja raportu kasowego odpowiadająca danej operacji kasowej.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="LiczbaPorzadkowa" type="xs:int" nillable="false">
        <xs:annotation>
          <xs:documentation>Liczba porządkowa pozycji raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Opis" type="xs:string" nillable="false">
        <xs:annotation>
          <xs:documentation>Opis pozycji raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KolekcjePolWlasnych" type="ddk:TKolekcjePolWlasnych" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Zbiory pól własnych dla operacji kasowych.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="DokumentDoKsiegowaniaId" type="ddk:TGuid" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator dokumentu do księgowania operacji kasowej odpowiadającej danej pozycji.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="TPozycjeRaportuKasowego">
    <xs:annotation>
      <xs:documentation>Kolekcja pozycji raportu kasowego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Pozycja" type="TPozycjaRaportuKasowego">
        <xs:annotation>
          <xs:documentation>Węzeł pozycji raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="TRaportKasowy">
    <xs:annotation>
      <xs:documentation>Raport kasowy wraz z wersją schematu.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Wersja" type="xs:string" nillable="false" fixed="2012">
        <xs:annotation>
          <xs:documentation>Wersja schematu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Naglowek" type="TNaglowekRaportuKasowego" nillable="false">
        <xs:annotation>
          <xs:documentation>Naglowek raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Pozycje" type="TPozycjeRaportuKasowego" nillable="true">
        <xs:annotation>
          <xs:documentation>Pozycje raportu kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:element name="Dokument" type="TRaportKasowy">
    <xs:annotation>
      <xs:documentation>Główny węzeł opakowujący raport kasowy.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>