				</xs:annotation>
			</xs:element>
			<xs:element name="PotraceniaNieopodatkowane" type="xs:decimal" nillable="false">
				<xs:annotation>
					<xs:documentation>Kwota nieopodatkowanych potrąceń.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Potracenia" type="xs:decimal" nillable="false">
