	<xs:complexType name="TWyplataBazowa">
		<xs:annotation>
			<xs:documentation>Bazowe pola wiersza wypłaty.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Indeks" type="xs:int" nillable="false">
				<xs:annotation>
					<xs:documentation>Indeks dla znajdowania opisu księgowego.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PracownikHistoria" type="ddk:TPositiveInt">
				<xs:annotation>
					<xs:documentation>Identyfikator podmiotu pracownika.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PracownikAdresHistoria" type="ddk:TPositiveInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identyfikator adresu pracownika.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UmowaObowiazujeOd" type="xs:date" nillable="false">
				<xs:annotation>
					<xs:documentation>Data początku obowiązywania umowy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UmowaObowiazujeDo" type="xs:date" nillable="true">
				<xs:annotation>
					<xs:documentation>Data końca obowiązywania umowy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PelenEtat" type="xs:boolean" nillable="false">
				<xs:annotation>
					<xs:documentation>Czy umowa z pracownikiem jest na pełen etat.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpisUmowy" type="xs:string" nillable="true">
				<xs:annotation>
					<xs:documentation>Opis umowy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KolekcjePolWlasnych" type="ddk:TKolekcjePolWlasnych" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Zbiór pól własnych wypłat listy płac.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumerUmowy" type="xs:string" nillable="true">
				<xs:annotation>
					<xs:documentation>Numer umowy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RodzajUmowyPracowniczej" type="xs:int">
