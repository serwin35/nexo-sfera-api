		<xs:annotation>
			<xs:documentation>Bazowy zbiór pól nagłówkowych listy płac.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Miesiac" type="xs:date" nillable="false">
				<xs:annotation>
					<xs:documentation>Miesiąc listy płac.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Tytul" type="xs:string" nillable="false">
				<xs:annotation>
					<xs:documentation>Tytuł listy płac.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Numer" type="xs:string" nillable="false">
				<xs:annotation>
					<xs:documentation>Numer listy płac.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataWyplaty" type="xs:date" nillable="false">
				<xs:annotation>
					<xs:documentation>Data wypłaty listy płac.</xs:documentation>
