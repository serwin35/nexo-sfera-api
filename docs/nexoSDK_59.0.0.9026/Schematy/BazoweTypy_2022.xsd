					<xs:documentation>Kwota składki zdrowotnej nieodliczanej od podatku.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SkladkiZUSPracownikaRazem" type="xs:decimal" nillable="false">
