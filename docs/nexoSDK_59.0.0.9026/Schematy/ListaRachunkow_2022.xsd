          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  
  <xs:element name="Dokument" type="TListaRachunkow">
    <xs:annotation>
      <xs:documentation>Główny węzeł opakowujący listę rachunków do umów pracowniczych.</xs:documentation>
    </xs:annotation>
  </xs:element>
