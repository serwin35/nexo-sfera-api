        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="TListaRachunkow">
    <xs:annotation>
      <xs:documentation>Lista rachunków do umów pracowniczych.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="bazowe:TListaRachunkowBazowa">
        <xs:sequence>
          <xs:element name="Naglowek" type="TNaglowekListyRachunkow" nillable="false">
