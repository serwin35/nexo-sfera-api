              <xs:documentation>Dane dotyczące PPK.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="WartosciSkladnikowPlacowych" type="bazowe:TWartosciSkladnikowPlacowych" minOccurs="1">
            <xs:annotation>
              <xs:documentation>Dane dotyczące wartosci składników płacowych</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  
  <xs:complexType name="TRachunkiDoUmowPracowniczych">
    <xs:annotation>
      <xs:documentation>Kolekcja rachunków do umów pracowniczych, zaliczek i składek ZUS.</xs:documentation>
