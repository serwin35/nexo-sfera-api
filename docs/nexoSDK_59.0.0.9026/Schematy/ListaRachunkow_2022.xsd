  xmlns:bazowe="http://schemas.insert.com.pl/2022/dokumentyDoKsiegowania/place/bazowe">
  <xs:annotation>
    <xs:documentation>Dane listy rachunków.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  <xs:import id="PolaWlasnePart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./Dane_2012_PolaWlasnePart.xsd" />
  <xs:import id="PlaceBazowePart" namespace="http://schemas.insert.com.pl/2022/dokumentyDoKsiegowania/place/bazowe" schemaLocation="BazoweTypy_2022.xsd" />
  
  <xs:complexType name="TNaglowekListyRachunkow">
    <xs:annotation>
      <xs:documentation>Zbiór pól nagłówkowych listy rachunków.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="bazowe:TNaglowekListyRachunkowBazowy">
        <xs:sequence>
          <xs:element name="DaneZaliczek" type="bazowe:TNaglowekListyRachunkowDaneZaliczek" nillable="false" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Dane dotyczące zaliczek.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DaneSkladekZUS" type="bazowe:TNaglowekListyRachunkowDaneSkladekZUS" nillable="false" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Dane dotyczące składek ZUS.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="DanePPK" type="bazowe:TNaglowekPPK" nillable="false" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Dane dotyczące PPK.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  
  <xs:complexType name="TRachunekDoUmowyPracowniczejZListyRachunkow">
