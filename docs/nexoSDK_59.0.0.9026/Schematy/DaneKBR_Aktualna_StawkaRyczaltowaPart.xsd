<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  id="Dane_StawkaRyczaltowaPart"
  elementFormDefault="qualified"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania"
  targetNamespace="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania"
  xmlns:ddk2012="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania">
	<xs:annotation>
		<xs:documentation>Dane stawki ryczałtowej.</xs:documentation>
	</xs:annotation>

	<xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />

  <xs:complexType name="TStawkaRyczaltowaKBR">
    <xs:annotation>
      <xs:documentation>Obiekt stawki ryczałtowej.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Id" type="xs:ID" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator jednoznacznie identyfikujący w ramach pliku XML dla stawki ryczałtowej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="BId" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator bazodanowy stawki ryczałtowej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Nazwa" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Nazwa stawki.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Stawka" type="xs:decimal" use="required">
      <xs:annotation>
        <xs:documentation>Wartość stawki.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Aktywna" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Czy stawka aktywna.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Symbol" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Symbol stawki.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

	<xs:complexType name="TStawkiRyczaltoweKBR">
		<xs:annotation>
			<xs:documentation>Kolekcja stawek ryczałtowych.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StawkaRyczaltowa" type="TStawkaRyczaltowaKBR" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Stawka ryczałtowa.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

</xs:schema>