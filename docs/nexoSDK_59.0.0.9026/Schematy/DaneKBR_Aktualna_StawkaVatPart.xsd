<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  id="Dane_StawkaVatPart"
  elementFormDefault="qualified"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania"
  targetNamespace="http://schemas.insert.com.pl/2025/dokumentyDoKsiegowania"
  xmlns:ddk2012="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania">
	<xs:annotation>
		<xs:documentation>Dane stawki VAT.</xs:documentation>
	</xs:annotation>

	<xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />

	<xs:complexType name="TStawkaVat">
		<xs:annotation>
			<xs:documentation>Obiekt stawki VAT.</xs:documentation>
		</xs:annotation>

		<xs:sequence>
			<xs:element name="Panstwa" type="TPanstwaStawkiVat" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Państwa.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>

		<xs:attribute name="Id" type="xs:ID" use="required">
			<xs:annotation>
				<xs:documentation>Identyfikator jednoznacznie identyfikujący w ramach pliku XML dla stawki VAT.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="BId" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Identyfikator bazodanowy stawki VAT.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Nazwa" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Nazwa stawki VAT.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Symbol" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>Symbol stawki VAT.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Stawka" type="xs:decimal" use="required">
			<xs:annotation>
				<xs:documentation>Wartość stawki VAT (wartość w zakresie [0; 1], gdzie 0.23 odpowiada 23%).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Polska" type="xs:boolean" use="optional">
			<xs:annotation>
				<xs:documentation>Czy jest to stawka polska.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="TStawkiVat">
		<xs:annotation>
			<xs:documentation>Kolekcja stawek VAT.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StawkaVat" type="TStawkaVat" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Stawka VAT.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="TPanstwaStawkiVat">
		<xs:annotation>
			<xs:documentation>Państwa stawki VAT.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PanstwoId" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identyfikator państwa.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

</xs:schema>