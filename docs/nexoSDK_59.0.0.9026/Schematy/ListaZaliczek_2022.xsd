          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  
  <xs:complexType name="TWyplatyZaliczki">
    <xs:annotation>
      <xs:documentation>Kolekcja pozycji zaliczek.</xs:documentation>
