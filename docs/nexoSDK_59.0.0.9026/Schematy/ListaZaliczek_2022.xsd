    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="bazowe:TNaglowekListyPlacBazowy">
        <xs:sequence>
          <xs:element name="DaneZaliczek" type="bazowe:TNaglowekListyPlacDaneZaliczek" nillable="false">
