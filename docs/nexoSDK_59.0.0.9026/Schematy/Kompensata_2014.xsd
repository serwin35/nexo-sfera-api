<?xml version="1.0" encoding="utf-8"?>
<!-- Uzyj xsd.exe do wygenerowania z tego kodu -->
<xs:schema 
  xmlns:xs="http://www.w3.org/2001/XMLSchema" 
  elementFormDefault="qualified" 
  xmlns="http://schemas.insert.com.pl/2014/dokumentyDoKsiegowania/rozrachunki" 
  targetNamespace="http://schemas.insert.com.pl/2014/dokumentyDoKsiegowania/rozrachunki" 
  xmlns:ddk="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania">
  <xs:annotation>
    <xs:documentation>Dane kompensaty.</xs:documentation>
  </xs:annotation>
  
  <xs:import id="TypyDanychPart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./TypyDanych_2012.xsd" />
  <xs:import id="PolaWlasnePart" namespace="http://schemas.insert.com.pl/2012/dokumentyDoKsiegowania" schemaLocation="./Dane_2012_PolaWlasnePart.xsd" />
  
  <xs:complexType name="TNaglowekKompensaty">
    <xs:annotation>
      <xs:documentation>Zbiór pól nagłówkowych kompensaty.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Data" type="xs:date" nillable="false">
        <xs:annotation>
          <xs:documentation>Data realizacji kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Wartosc" type="xs:decimal" nillable="false">
        <xs:annotation>
          <xs:documentation>Wartość kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Numer" type="xs:string" nillable="false">
        <xs:annotation>
          <xs:documentation>Numer kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PodmiotHistoria" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Podmiot którego dotyczy kompensata.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PodmiotAdresHistoria" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Adres podmiotu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="GrupaPodmiotu" type="ddk:TPositiveInt" nillable="true">
        <xs:annotation>
          <xs:documentation>Grupa podmiotu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WalutaNaleznosci" type="ddk:TGuid" nillable="false">
        <xs:annotation>
          <xs:documentation>Waluta należności.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WalutaZobowiazan" type="ddk:TGuid" nillable="false">
        <xs:annotation>
          <xs:documentation>Waluta zobowiązań.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Opis" type="xs:string" nillable="false">
        <xs:annotation>
          <xs:documentation>Numer kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TPozycjaKompensaty">
    <xs:annotation>
      <xs:documentation>Zbiór pól pozycji kompensaty.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Wartosc" type="xs:decimal" nillable="false">
        <xs:annotation>
          <xs:documentation>Wartość pozycji kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataRozrachunku" type="xs:date" nillable="true">
        <xs:annotation>
          <xs:documentation>Data powstania rozrachunku.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Dokument" type="xs:string" nillable="true">
        <xs:annotation>
          <xs:documentation>Dokument źródłowy rozrachunku.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="RodzajRozrachunku" type="ddk:TGuid" nillable="false">
        <xs:annotation>
          <xs:documentation>Rodzaj rozrachunku.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Tytulem" type="xs:string" nillable="true">
        <xs:annotation>
          <xs:documentation>Tytuł rozrachunku.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TypDokumentuZrodlowego" type="xs:string" nillable="true">
        <xs:annotation>
          <xs:documentation>Identyfikator typu dokumentu źródłowego rozrachunku.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Waluta" type="ddk:TGuid" nillable="false">
        <xs:annotation>
          <xs:documentation>Waluta pozycji.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Kurs" type="xs:decimal" nillable="true">
        <xs:annotation>
          <xs:documentation>Kurs pozycji.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KursLiczbaJednostek" type="xs:int" nillable="true">
        <xs:annotation>
          <xs:documentation>Liczba jednostek dla kursu pozycji.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="IdDokumentuRozliczanego" type="ddk:TGuid" nillable="false">
        <xs:annotation>
          <xs:documentation>Identyfikator dokumentu rozliczanego przez rozrachunek.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>    
    <xs:attribute name="Index" type="xs:int" use="required">
      <xs:annotation>
        <xs:documentation>Indeks pozycji.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="TPozycjeKompensaty">
    <xs:annotation>
      <xs:documentation>Kolekcja pozycji kompensaty.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Pozycja" type="TPozycjaKompensaty">
        <xs:annotation>
          <xs:documentation>Węzeł pozycji kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="TKompensata">
    <xs:annotation>
      <xs:documentation>Kompensata wraz z wersją schematu.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Wersja" type="xs:string" nillable="false" fixed="2014">
        <xs:annotation>
          <xs:documentation>Wersja schematu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Naglowek" type="TNaglowekKompensaty" nillable="false">
        <xs:annotation>
          <xs:documentation>Nagłówek kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Naleznosci" type="TPozycjeKompensaty" nillable="true">
        <xs:annotation>
          <xs:documentation>Pozycje należności kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Zobowiazania" type="TPozycjeKompensaty" nillable="true">
        <xs:annotation>
          <xs:documentation>Pozycje zobowiązań kompensaty.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:element name="Dokument" type="TKompensata">
    <xs:annotation>
      <xs:documentation>Główny węzeł opakowujący kompensatę.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>