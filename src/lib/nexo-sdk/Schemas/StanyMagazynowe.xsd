<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://schemas.insert.com.pl/2013/hop/stanymagazynowe" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      <!--Ilosc jest w jednostce bazowej-->
      <!--Cena netto jest ceną jednostkową-->
      <!--Termin waznosci w formacie yyyy-MM-dd -->
      Stany towarów, opakowań, kompletów w poszczególnych magazynach i w rozbiciu na dostawy.
    </xs:documentation>
  </xs:annotation>
  <xs:element name="StanyMagazynowe">
    <xs:annotation>
      <xs:documentation>Stany towarów, opakowań, kompletów w magazynach, w rozbiciu na dostawy.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="StanMagazynu">
          <xs:annotation>
            <xs:documentation>Stan towarów w magazynie. Tylko pozycje o niezerowym stanie. Dla każdego elementu StanMagazynu generowany jest przy imporcie jeden dokument IW.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Magazyn">
                <xs:annotation>
                  <xs:documentation>Informacje o magazynie.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="Symbol" type="xs:string" use="required">
                    <xs:annotation>
                      <xs:documentation>Symbol magazynu.</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="unbounded" name="Asortyment">
                <xs:annotation>
                  <xs:documentation>Informacje o stanie asortymentu w magazynie.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element maxOccurs="unbounded" name="Dostawa">
                      <xs:annotation>
                        <xs:documentation>Informacje o tej części dostawy, która pozostała w magazynie.</xs:documentation>
                      </xs:annotation>  
                      <xs:complexType>
                        <xs:attribute name="Numer" type="xs:string" use="optional">
                          <xs:annotation>
                            <xs:documentation>Kod dostawy.</xs:documentation>
                          </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="Kod" type="xs:string" use="optional">
                          <xs:annotation>
                            <xs:documentation>Kod kreskowy dostawy.</xs:documentation>
                          </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="TerminWaznosci" type="xs:date" use="optional">
                          <xs:annotation>
                            <xs:documentation>Termin ważności w formacie yyyy-MM-dd.</xs:documentation>
                          </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="Opis" type="xs:string" use="optional">
                          <xs:annotation>
                            <xs:documentation>Opis dostawy.</xs:documentation>
                          </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="Ilosc" type="xs:string" use="required">
                          <xs:annotation>
                            <xs:documentation>Ilość towaru w dostawie w podstawowej j.m. towaru.</xs:documentation>
                          </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="CenaNetto" type="xs:decimal" use="optional">
                          <xs:annotation>
                            <xs:documentation>Cena netto podstawowej jednostki towaru w dostawie.</xs:documentation>
                          </xs:annotation>
                        </xs:attribute>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="Symbol" type="xs:string" use="required">
                    <xs:annotation>
                      <xs:documentation>Symbol pozycji asortymentu, której dotyczy informacja o stanie.</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
