        <xs:documentation>Identyfikator kartoteki.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Typ" type="TTypKontaKsiegowego" use="optional">
      <xs:annotation>
        <xs:documentation>Typ konta księgowego. Należy podać dla syntetyki, nie można dla analityki.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="SaldoDwustronne" type="xs:boolean" use="optional">
      <xs:annotation>
        <xs:documentation>Znacznik "saldo dwustronne". Należy podać dla syntetyki, nie można dla analityki.</xs:documentation>
