  <xs:complexType name="TDefinicjaKontaKsiegowego">
    <xs:annotation>
      <xs:documentation>Definicja konta księgowego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>

      <xs:element minOccurs="0" name="WlasneRozszerzone">
        <xs:annotation>
          <xs:documentation>Wartości pól własnych kont ksiegowych.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="PoleRozszerzone">
              <xs:annotation>
                <xs:documentation>Pole własne rozszerzone konta ksiegowego. Zawartość tego elementu jest wartością pola.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:simpleContent>
                  <xs:extension base="xs:string">
                    <xs:attribute name="Nazwa" type="xs:string" use="required">
                      <xs:annotation>
                        <xs:documentation>Nazwa pola własnego.</xs:documentation>
                      </xs:annotation>
                    </xs:attribute>
                  </xs:extension>
                </xs:simpleContent>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      
      <xs:element name="Analityki" type="TDefinicjeKontKsiegowych">
        <xs:annotation>
          <xs:documentation>Analityki.</xs:documentation>
        </xs:annotation>
      </xs:element>

    </xs:sequence>
    <xs:attribute name="Id" type="xs:ID" use="required">
      <xs:annotation>
        <xs:documentation>Identyfikator na użytek referencjonowania w pliku XML.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Numer" type="xs:string" use="optional">
      <xs:annotation>
