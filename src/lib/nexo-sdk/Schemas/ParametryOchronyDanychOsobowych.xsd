<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2018/hop/parametryOchronyDanychOsobowych"
           xmlns="http://schemas.insert.com.pl/2018/hop/parametryOchronyDanychOsobowych"
           xmlns:wspolne="http://schemas.insert.com.pl/2013/hop"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:import id="WspolnePart" namespace="http://schemas.insert.com.pl/2013/hop" schemaLocation="Wspolne.xsd"/>

  <xs:annotation>
    <xs:documentation>Informacje o parametrach ochrony danych osobowych.</xs:documentation>
  </xs:annotation>
  
  <xs:complexType name="TParametryOchronyDanychOsobowych">
    <xs:sequence>
      <xs:element name="AdministratorDanych" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Dane Administratora Danych.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InspektorOchronyDanychOsobowych" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Dane Administratora Danych.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ObowiazekInformacyjny" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Dane Administratora Danych.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ZnakZastapienia" type="TZnakZastapienia" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Znak zastąpienia przy anonimizacji.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TrescKomunikatu" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Treść komunikatu po anonimizacji.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="TZnakZastapienia">
    <xs:restriction base="xs:string">
      <xs:length value="1" /> 
    </xs:restriction>
  </xs:simpleType>
  
  <xs:element name="ParametryOchronyDanychOsobowych" type="TParametryOchronyDanychOsobowych">
    <xs:annotation>
      <xs:documentation>Dane dotyczące parametrów ochrony danych osobowych.</xs:documentation>
    </xs:annotation>
  </xs:element>
  
</xs:schema>