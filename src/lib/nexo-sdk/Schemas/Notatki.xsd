<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
            targetNamespace="http://schemas.insert.com.pl/2013/hop/notatki"
            xmlns="http://schemas.insert.com.pl/2013/hop/notatki"
            xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>Ewidencja notatek podmiotów.</xs:documentation>
  </xs:annotation>

  <xs:complexType name ="TNotatka">
    <xs:annotation>
      <xs:documentation>Notatka podmiotu.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Podmiot" type="xs:string">
        <xs:annotation>
          <xs:documentation>Symbol podmiotu, z którym jest związana notatka.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Opiekun" minOccurs="0" type="xs:string">
        <xs:annotation>
          <xs:documentation>Symbol opiekuna zgodny z jego symbolem w danych o pracownikach i użytkownikach.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Data" minOccurs="0" type="xs:date">
        <xs:annotation>
          <xs:documentation>Data notatki.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Tytul" type="xs:string">
        <xs:annotation>
          <xs:documentation>Tytul notatki.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Tresc" type="xs:string">
        <xs:annotation>
          <xs:documentation>Treść notatki.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Priorytet" minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Określa, czy notatka jest priorytetowa.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Drukuj"  minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Określa, czy notatka ma być drukowana.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Przypnij"  minOccurs="0" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Określa, czy notatka ma zostać przypięta do powiązanych dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Notatki">
    <xs:annotation>
      <xs:documentation>Notatki podmiotów.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="Notatka" type="TNotatka"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>