      </xs:element>
      <xs:element name="SkladnikiParametryczne" type="TSkladnikiParametryczne">
        <xs:annotation>
          <xs:documentation>Dane składników parametrycznych.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
