    <xs:sequence>
      <xs:element name="SkladnikParametryczny" type="TSkladnikParametryczny" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Dane składnika paramtrycznego.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
