<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" 
           elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2014/hop/przyczynyniepowodzenprocesowofertowych"
           xmlns="http://schemas.insert.com.pl/2014/hop/przyczynyniepowodzenprocesowofertowych"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:annotation>
    <xs:documentation>Przyczyny niepowodzeń procesów ofertowych.</xs:documentation>
