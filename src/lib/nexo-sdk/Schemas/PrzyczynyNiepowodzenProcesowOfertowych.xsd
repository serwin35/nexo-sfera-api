        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="PrzyczynyNiepowodzenProcesowOfertowych">
    <xs:annotation>
      <xs:documentation>Przyczyny niepowodzenia procesu ofertowego.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded" >
        <xs:element name="Przyczyna" type="TPrzyczynaNiepowodzeniaProcesuOfertowego">
