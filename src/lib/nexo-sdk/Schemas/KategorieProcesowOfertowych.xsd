<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" 
           elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2014/hop/kategorieprocesowofertowych"
           xmlns="http://schemas.insert.com.pl/2014/hop/kategorieprocesowofertowych"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:annotation>
    <xs:documentation>Kategorie procesów ofertowych.</xs:documentation>
  </xs:annotation>

  <xs:complexType name="TKategoriaProcesuOfertowego">
    <xs:annotation>
      <xs:documentation>Dane kategorii procesu ofertowego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Nazwa" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nazwa kategorii procesu ofertowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Aktywna" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Określenie, czy kategoria ma się pojawiać w systemie, np. w filtrach.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="KategorieProcesowOfertowych">
    <xs:annotation>
      <xs:documentation>Kategorie procesów ofertowych.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded" >
        <xs:element name="Kategoria" type="TKategoriaProcesuOfertowego">
          <xs:annotation>
            <xs:documentation>Kategoria procesu ofertowego.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
</xs:schema>
