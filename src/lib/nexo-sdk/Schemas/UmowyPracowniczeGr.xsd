<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2015/hop/gratyfikant/umowyPracownicze"
           xmlns="http://schemas.insert.com.pl/2015/hop/gratyfikant/umowyPracownicze"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:wspolne="http://schemas.insert.com.pl/2013/hop">
  <xs:annotation>
    <xs:documentation>Informacje o umowach o pracę oraz umowach cywilnoprawnych.</xs:documentation>
  </xs:annotation>

  <xs:import id="WspolnePart" namespace="http://schemas.insert.com.pl/2013/hop" schemaLocation="Wspolne.xsd"/>

  <xs:simpleType name="TTypSkladnikaPlacowego">
    <xs:annotation>
      <xs:documentation>Określa typ składnika płacowego.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Naliczenie">
        <xs:annotation>
          <xs:documentation>Składnik płacowy jako naliczenie.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Potracenie">
        <xs:annotation>
          <xs:documentation>Składnik płacowy jako potrącenie.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TTypPlatnika">
