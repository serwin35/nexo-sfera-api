      <xs:enumeration value="RCA">
        <xs:annotation>
          <xs:documentation>Raport RCA.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RZA">
        <xs:annotation>
          <xs:documentation>Raport RZA.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TSkladkiZUS">
    <xs:annotation>
      <xs:documentation>Definicja naliczanych składek ZUS.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="Emerytalne" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Naliczanie składek emerytalnych.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Rentowe" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Naliczanie składek rentowych.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Zdrowotne" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Naliczanie składek zdrowotnych.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Chorobowe" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Naliczanie składek chorobowych.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Wypadkowe" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Naliczanie składek wypadkowych.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="FP" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Naliczanie składek Funduszu Pracy i Fundusz Solidarnościowy.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="FGSP" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>Naliczanie składek Funduszu Gwarantowanych Świadczeń Pracowniczych.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="NieOgraniczajChorobowego" type="xs:boolean">
      <xs:annotation>
        <xs:documentation>Nie ograniczaj chorobowego (dla umów cywilnoprawnych).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="NieOgraniczajZdrowotnego" type="xs:boolean">
      <xs:annotation>
        <xs:documentation>Nie ograniczaj zdrowotnego (dla umów cywilnopracnych).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="TOdliczanieKUP">
    <xs:annotation>
      <xs:documentation>Typ odliczania kosztów uzyskania przychodu.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Odliczac">
        <xs:annotation>
          <xs:documentation>Odliczanie kosztów uzyskania przychodu.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NieOdliczac">
        <xs:annotation>
          <xs:documentation>Brak odliczania kosztów uzyskania przychodu.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OdliczacPowiekszone">
        <xs:annotation>
          <xs:documentation>Odliczanie powiększonych kosztów uzyskania przychodu.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WgUstawienPracownika">
        <xs:annotation>
          <xs:documentation>Odlicznie kosztów według parametrów zdefiniowanych w danych pracownika.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TPobieranieZaliczki">
    <xs:annotation>
      <xs:documentation>Typ naliczania zaliczki na podatek.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="NiePobieraj">
        <xs:annotation>
          <xs:documentation>Nie pobieraj zaliczki na podatek.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WgUstawienPracownika">
        <xs:annotation>
          <xs:documentation>Pobieraj zaliczkę według ustawień w zdefiniowanych w danych pracownika.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NiePobierajDoKwotyWolnej">
        <xs:annotation>
          <xs:documentation>Nie pobieraj zaliczki do kwoty wolnej.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TPodatekUP">
    <xs:annotation>
      <xs:documentation>Dane naliczanego podatku w ramach umowy o pracę.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="OdliczanieKUP" type="TOdliczanieKUP">
        <xs:annotation>
          <xs:documentation>Rodzaj naliczania kosztów uzyskania przychodu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PobieranieZaliczki" type="TPobieranieZaliczki" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Rodzaj naliczania kosztów uzyskania przychodu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="OdliczanieUlgi" type="wspolne:TOdliczanieUlgi" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Rodzaj odliczania ulgi podatkowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="NaliczaniePodatku" type="xs:boolean">
      <xs:annotation>
        <xs:documentation>Włączenie naliczania podatku w ramach umowy.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="NaliczanieZaliczki" type="xs:boolean" use="optional">
      <xs:annotation>
        <xs:documentation>Włączenie naliczania zalicznki na podatek.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="OdliczanieUlgi" type="xs:boolean" use ="optional">
      <xs:annotation>
        <xs:documentation>Włączenie odliczania ulgi podatkowej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="NaliczanieUlgiDlaKlasySredniej" type="xs:boolean" use="optional" >
      <xs:annotation>
        <xs:documentation>Włączenie naliczania ulgi dla klasy średniej.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="TRodzajPrzychodu">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Dzialalnosc">
        <xs:annotation>
          <xs:documentation>Działalność wykonywana osobiście.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
