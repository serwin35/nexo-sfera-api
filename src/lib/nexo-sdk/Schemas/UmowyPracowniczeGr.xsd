        </xs:annotation>
      </xs:element>
      <xs:element name="KosztyUzyskaniaPrzychodu" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Koszty uzyskania przychodu.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>


