        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="InneZrodla">
        <xs:annotation>
          <xs:documentation>Inne źródła.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UmowaZlecenie">
        <xs:annotation>
          <xs:documentation>Należności z tytułu umowy zlecenie.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TPodatekUC">
    <xs:annotation>
      <xs:documentation>Dane dotyczące podatku w ramach umowy cywilnoprawnej.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ZryczaltowanyPodatek" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Zryczałtowany podatek.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="RodzajPrzychodu" type="TRodzajPrzychodu">
        <xs:annotation>
          <xs:documentation>Rodzaj przychodu.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KosztyUzyskaniaPrzychodu">
        <xs:annotation>
          <xs:documentation>Koszty uzyskania przychodu (procentowo lub kwotowo - zależnie od atrybutu).</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:decimal">
              <xs:attribute name="Kwotowo" type="xs:boolean" default="false">
                <xs:annotation>
                  <xs:documentation>Określa rodzaj wartości kosztów uzyskania przychodu.</xs:documentation>
                </xs:annotation>
              </xs:attribute>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="PobieranieZaliczki" type="TPobieranieZaliczki" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Rodzaj naliczania zaliczki na podatek.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="OdliczanieUlgi" type="wspolne:TOdliczanieUlgi" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Rodzaj odliczania ulgi podatkowej.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="NaliczanieZaliczki" type="xs:boolean" use="optional" >
      <xs:annotation>
        <xs:documentation>Włączenie naliczania zaliczki na podatek.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="TSkalaPodatkowa">
