        </xs:annotation>
      </xs:element>-->
      <xs:element name="Oddzial" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Symbol oddziału.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Magazyn" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Symbol magazyn.</xs:documentation>
        </xs:annotation>
      </xs:element>
