      <xs:element name="DataWystawienia" type="xs:date" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Data wystawienia oferty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="MiejsceWystawienia" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Miejsce wystawienia oferty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TerminRealizacji" type="xs:date" minOccurs="0">
        <xs:annotation>
