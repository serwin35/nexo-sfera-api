<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  attributeFormDefault="unqualified" 
  elementFormDefault="qualified" 
  targetNamespace="http://schemas.insert.com.pl/2013/hop" 
  xmlns="http://schemas.insert.com.pl/2013/hop"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="TypDokumentuTozsamosci">
    <xs:annotation>
      <xs:documentation>Określa rodzaj dokumentu tożsamości.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Brak">
        <xs:annotation>
          <xs:documentation>Brak dokumentu.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Inny">
        <xs:annotation>
          <xs:documentation>Inny typ dokumentu.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DowodOsobisty">
        <xs:annotation>
          <xs:documentation>Dowód osobisty.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Paszport">
        <xs:annotation>
          <xs:documentation>Paszport.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TypIdentyfikatora">
    <xs:annotation>
      <xs:documentation>Określa typ identyfikatora (NIP, PESEL).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="NIP">
        <xs:annotation>
          <xs:documentation>NIP</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PESEL">
        <xs:annotation>
          <xs:documentation>PESEL</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TypKontaktu">
    <xs:annotation>
      <xs:documentation>Określa typ kontaktu.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Telefon">
        <xs:annotation>
          <xs:documentation>Telefon</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Faks">
        <xs:annotation>
          <xs:documentation>Faks</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Email">
        <xs:annotation>
          <xs:documentation>E-mail</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WWW">
        <xs:annotation>
          <xs:documentation>WWW</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GaduGadu">
        <xs:annotation>
          <xs:documentation>Gadu-Gadu</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Skype">
        <xs:annotation>
          <xs:documentation>Skype</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Kontakty">
    <xs:annotation>
      <xs:documentation>Lista danych kontaktowych.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="Kontakt" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Dane umożliwiające kontakt.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Wartosc" type="xs:string">
              <xs:annotation>
                <xs:documentation>Dane kontaktowe. W zależności od typu może to być numer, czy adres.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="Komentarz" type="xs:string"/>
          </xs:sequence>
          <xs:attribute name="Typ" type="TypKontaktu" use="required">
            <xs:annotation>
              <xs:documentation>Sposób kontaktu.</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="Podstawowy" type="xs:boolean" use="optional">
            <xs:annotation>
              <xs:documentation>Określa, czy jest to podstawowy kontakt.</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FirmaUE">
    <xs:annotation>
      <xs:documentation>Informacje rejestracyjne do celu handlu wewnątrzwspólnotowego w UE.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="NIPUE" type="xs:string">
        <xs:annotation>
          <xs:documentation>Numer identyfikacji podatkowej do celów handlu wewnątrzwspólnotowego - VIN.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PanstwoUE" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nazwa państwa, z którego pochodzi VIN.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="Kontakt">
    <xs:annotation>
      <xs:documentation>Dane umożliwiające kontakt.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Telefon" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Numery telefonów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Faks" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Numery faksów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Email" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Adres e-mail.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="TTypAdresu">
    <xs:annotation>
      <xs:documentation>Rodzaj importowanego adresu (np. kontrahenta, firmy).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Glowny">
        <xs:annotation>
          <xs:documentation>Główny (podstawowy) adres. W kontekście podmiotu może wystąpić najwyżej raz.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Korespondencyjny">
        <xs:annotation>
          <xs:documentation>Adres do korespondencji. W kontekście podmiotu może wystąpić wielokrotnie.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Wysylka">
        <xs:annotation>
          <xs:documentation>Adres do wysyłki. W kontekście podmiotu może wystąpić wielokrotnie.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Zameldowania">
        <xs:annotation>
          <xs:documentation>Adres zameldowania. W kontekście podmiotu może wystąpić najwyżej raz.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TAdres">
    <xs:annotation>
      <xs:documentation>Dane adresowe z określeniem typu.</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element minOccurs="0" name="AdresLinie">
        <xs:annotation>
          <xs:documentation>Dane adresowe w podziale na linie.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:all>
            <xs:element minOccurs="0" name="Nazwa" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa dodatkowa skojarzona z adresem. Nie ma znaczenia dla adresu głównego.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="Panstwo" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa państwa.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Linia1" type="xs:string">
              <xs:annotation>
                <xs:documentation>Pierwsza linia adresu.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Linia2" type="xs:string">
              <xs:annotation>
                <xs:documentation>Druga linia adresu.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Linia3" type="xs:string">
              <xs:annotation>
                <xs:documentation>Trzecia linia adresu.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" name="AdresSzczegoly">
        <xs:annotation>
          <xs:documentation>Dane adresowe w podziale na szczegóły.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:all>
            <xs:element minOccurs="0" name="Nazwa" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa dodatkowa skojarzona z adresem. Nie ma znaczenia dla adresu głównego.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="Panstwo" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa państwa.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Wojewodztwo" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa województwa.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Miasto" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa miejscowości.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Ulica" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa ulicy, placu itp.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="NrDomu" type="xs:string">
              <xs:annotation>
                <xs:documentation>Numer domu.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="NrLokalu" type="xs:string">
              <xs:annotation>
                <xs:documentation>Numer lokalu.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Kod" type="xs:string">
              <xs:annotation>
                <xs:documentation>Kod pocztowy.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Poczta" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa poczty.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Skrytka" type="xs:string">
              <xs:annotation>
                <xs:documentation>Numer skrytki pocztowej.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Gmina" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa gminy.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="Powiat" type="xs:string">
              <xs:annotation>
                <xs:documentation>Nazwa powiatu.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:all>
        </xs:complexType>
      </xs:element>
    </xs:choice>

    <xs:attribute name="Rodzaj" type="TTypAdresu" use="required">
      <xs:annotation>
        <xs:documentation>Rodzaj adresu pod kątem zastosowania (główny, korespondencyjny, do wysyłki etc.).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="Adresy">
    <xs:annotation>
      <xs:documentation>Lista adresów.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Adres" type="TAdres" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Pojedyncze dane adresowe.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DokumentTozsamosci">
    <xs:annotation>
      <xs:documentation>Cechy dokumentu tożsamości.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="Numer" type="xs:string">
        <xs:annotation>
          <xs:documentation>Numer dokumentu tożsamości.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataWydania" type="xs:date" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Data wydania dokumentu tożsamości.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Organ" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Nazwa organu, który wydał dokument tożsamości.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="Typ" type="TypDokumentuTozsamosci" use="required">
      <xs:annotation>
        <xs:documentation>Typ dokumentu tożsamości.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="Obowiazkowy">
    <xs:annotation>
      <xs:documentation>Wymagany, niepusty ciąg znaków.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TypPolaWlasnegoRozszerzonego">
    <xs:annotation>
      <xs:documentation>Określa typ pola własnego.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Tekst">
        <xs:annotation>
          <xs:documentation>Tekst.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Data">
        <xs:annotation>
          <xs:documentation>Data.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Kwota">
        <xs:annotation>
          <xs:documentation>Kwota.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Liczba">
        <xs:annotation>
          <xs:documentation>Liczba.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Slownik">
        <xs:annotation>
          <xs:documentation>Słownik.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SlownikWlasny">
        <xs:annotation>
          <xs:documentation>Słownik własny.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQL">
        <xs:annotation>
          <xs:documentation>Zapytanie SQL.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PoleWyboru">
        <xs:annotation>
          <xs:documentation>Pole wyboru.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TSlownik">
    <xs:annotation>
      <xs:documentation>Dane przechowujące nazwę i definicję słownika własnego</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="NazwaSlownika" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Nazwa słownika własnego. Jeśli jest nie podana będzie generowana automatycznie.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WartosciSlownika" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Wartosc" minOccurs="0" maxOccurs="unbounded" type="TWartoscSlownika">
              <xs:annotation>
                <xs:documentation>Wartość słownika własnego.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="TWartoscSlownika">
    <xs:annotation>
      <xs:documentation>Dane przechowujące wartość słownika własnego.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="Aktywna"  type="xs:boolean" use="optional" default="true">
          <xs:annotation>
            <xs:documentation>Określa czy wartość jest aktywna (domyślnie importowana jako aktywna).</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>


  <xs:complexType name="TParametryHistoriowane">
    <xs:annotation>
      <xs:documentation>Dane przechowujące nazwę i definicję słownika własnego</xs:documentation>
    </xs:annotation>
    <xs:sequence>
        <xs:element name="Wartosc" minOccurs="0" maxOccurs="unbounded" type="TWartoscParametruHistoriowanego">
          <xs:annotation>
            <xs:documentation>Wartość historiowana.</xs:documentation>
          </xs:annotation>
        </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TWartoscParametruHistoriowanego">
    <xs:sequence>
      <xs:element name="DataOd" type="xs:date" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Od kiedy obowiązuje dana wartość.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Wartosc" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Wartość.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TPoleWlasneRozszerzone">
    <xs:annotation>
      <xs:documentation>Dane przechowujące definicję rozszerzonego pola własnego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Nazwa" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Nazwa pola własnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Typ" type="TypPolaWlasnegoRozszerzonego" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Typ pola własnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="WartoscDomyslna" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Wartość domyślna.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Wymagane" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Czy pole własne jest wymagane.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Widoczne" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Czy pole własne jest widoczne.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Edytowalne" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Czy pole własne jest edytowalne.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Klonowalne" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Czy pole własne jest klonowalne.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Przecyzja" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Precyzja kwoty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Format" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Format kwoty.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SlownikWlasny" type="TSlownik" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Definicja słownika własnego jeśli wybrany jest typ Slownik / SQL.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TElementBibliotekiDokumentow">
    <xs:annotation>
      <xs:documentation>Dane elementu biblioteki dokumentów</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Id" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Identyfikator elementu biblioteki dokumentów. Klucz sztuczny na potrzeby powiązań z podpisem elektronicznym.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Nazwa" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nazwa elementu biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Opis" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Opis elementu biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Typ" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Rozszerzenie elementu biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Kategoria" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Nazwa kategorii elementu biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="AktaPracownicze" type="xs:boolean" default="false" use="optional">
                <xs:annotation>
                  <xs:documentation>Czy kategoria akt pracowniczych.</xs:documentation>
                </xs:annotation>
              </xs:attribute>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="NumerKary" type="xs:int" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Numer kary (dla kategorii D akt pracowniczych)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Dodal" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Sygnatura księgowa użytkownika, który dodał element do biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataDodania" type="xs:dateTime" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Data i czas dodania elementu do biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Zmodyfikowal" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Sygnatura księgowa użytkownika, który dokonał ostatniej modyfikacji elementu biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataModyfikacji" type="xs:dateTime" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Data i czas ostatniej modyfikacji elementu biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ElementPodpisany" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Identyfikator powiązanego elementu biblioteki dokumentów, dla którego bieżący element jest podpisem.</xs:documentation>
        </xs:annotation>
      </xs:element>
