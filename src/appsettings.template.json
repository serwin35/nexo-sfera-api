{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NexoSferaApi": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Sfera": {
    "Server": "${SFERA_SERVER}",
    "Database": "${SFERA_DATABASE}",
    "UseWindowsAuth": "${SFERA_USE_WINDOWS_AUTH}",
    "SqlLogin": "${SFERA_SQL_LOGIN}",
    "SqlPassword": "${SFERA_SQL_PASSWORD}",
    "NexoLogin": "${SFERA_NEXO_LOGIN}",
    "NexoPassword": "${SFERA_NEXO_PASSWORD}",
    "Product": "${SFERA_PRODUCT}",
    "DefaultWarehouse": "${SFERA_DEFAULT_WAREHOUSE}",
    "DefaultBranch": "${SFERA_DEFAULT_BRANCH}",
    "DefaultCashRegister": "${SFERA_DEFAULT_CASH_REGISTER}"
  },
  "ApiKeys": {
    "Keys": [
      {
        "Key": "${API_KEY}",
        "Name": "Primary API Key",
        "IsActive": true
      }
    ]
  }
}
