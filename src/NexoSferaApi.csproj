  <!-- Copy ALL SDK files to output directory -->
  <ItemGroup>
    <ContentWithTargetPath Include="$(NexoSdkPath)\**\*.*" Exclude="$(NexoSdkPath)\**\*.xml;$(NexoSdkPath)\Microsoft.Extensions.*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <!-- Ensure SDK DLLs are copied even during publish -->
  <Target Name="CopySdkFiles" AfterTargets="Build">
    <ItemGroup>
      <SdkFiles Include="$(NexoSdkPath)\**\*.*" Exclude="$(NexoSdkPath)\**\*.xml;$(NexoSdkPath)\Microsoft.Extensions.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SdkFiles)" DestinationFolder="$(OutputPath)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

