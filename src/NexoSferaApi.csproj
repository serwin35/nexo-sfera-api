<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Configurable SDK Path - can be overridden via command line or environment -->
  <!-- Usage: dotnet build -p:NexoSdkPath="C:\Path\To\SDK" -->
  <PropertyGroup>
    <NexoSdkPath Condition="'$(NexoSdkPath)' == ''">lib\nexo-sdk</NexoSdkPath>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nexo Sfera SDK References (included in lib/nexo-sdk) -->
    <Reference Include="InsERT.Moria.API">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.API.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Sfera">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Sfera.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.ModelDanych">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.ModelDanych.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Asortymenty">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Asortymenty.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Klienci">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Klienci.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.ModelOrganizacyjny">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.ModelOrganizacyjny.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Promocje">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Promocje.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Logistyka">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Logistyka.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Finanse">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Finanse.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Kasa">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Kasa.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Bank">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Bank.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Rozrachunki">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Rozrachunki.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.Core">
      <HintPath>$(NexoSdkPath)\InsERT.Mox.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Common.Product">
      <HintPath>$(NexoSdkPath)\InsERT.Common.Product.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFrameworkSupport">
      <HintPath>$(NexoSdkPath)\InsERT.Mox.EntityFrameworkSupport.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.DaneDomyslne">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.DaneDomyslne.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFramework.Core">
      <HintPath>$(NexoSdkPath)\InsERT.Mox.EntityFramework.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Security.Core">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Security.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Security">
      <HintPath>$(NexoSdkPath)\InsERT.Moria.Security.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.Security.Sql">
      <HintPath>$(NexoSdkPath)\InsERT.Mox.Security.Sql.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy SDK DLLs to output directory -->
  <ItemGroup>
    <None Include="$(NexoSdkPath)\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
