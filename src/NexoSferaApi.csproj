<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Required for Nexo SDK - it needs Windows Desktop types -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required for Nexo SDK EF6 serialization -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <!-- Enable Windows targeting for cross-platform builds -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Force all NuGet deps to output dir - needed because MCP requires Microsoft.Extensions v10.x
         which is higher than what .NET 8 shared framework provides -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Runtime configuration matching Nexo SDK Importer settings -->
  <!-- These settings are CRITICAL for Entity Framework compatibility with Nexo SDK -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Reflection.Metadata.MetadataUpdater.IsSupported" Value="false" />
    <RuntimeHostConfigurationOption Include="System.Runtime.Serialization.EnableUnsafeBinaryFormatterSerialization" Value="true" />
    <RuntimeHostConfigurationOption Include="CSWINRT_USE_WINDOWS_UI_XAML_PROJECTIONS" Value="false" />
    <!-- Required for Nexo SDK globalization compatibility -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
    <!-- Potential fixes for EF6 expression compilation compatibility -->
    <RuntimeHostConfigurationOption Include="System.Linq.Expressions.DynamicExpressionVisitor.IsSupported" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeCompiled" Value="true" />
  </ItemGroup>

  <!-- Configurable SDK Path - can be overridden via command line or environment -->
  <!-- Usage: dotnet build -p:NexoSdkPath="C:\Path\To\SDK" -->
  <PropertyGroup>
    <NexoSdkPath Condition="'$(NexoSdkPath)' == ''">lib\nexo-sdk</NexoSdkPath>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <!-- SqlClient packages matching Artoit SDK configuration -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.8.0-preview.1" />
    <!-- Explicit pins: MCP 0.8.0 pulls in 10.x Extensions which must be deployed alongside net8.0 app -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.2" />
  </ItemGroup>

