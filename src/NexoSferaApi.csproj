<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nexo Sfera SDK References (included in lib/nexo-sdk) -->
    <Reference Include="InsERT.Moria.API">
      <HintPath>lib\nexo-sdk\InsERT.Moria.API.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Sfera">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Sfera.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.ModelDanych">
      <HintPath>lib\nexo-sdk\InsERT.Moria.ModelDanych.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Asortymenty">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Asortymenty.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Klienci">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Klienci.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.ModelOrganizacyjny">
      <HintPath>lib\nexo-sdk\InsERT.Moria.ModelOrganizacyjny.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Promocje">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Promocje.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Logistyka">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Logistyka.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Finanse">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Finanse.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Kasa">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Kasa.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Bank">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Bank.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Rozrachunki">
      <HintPath>lib\nexo-sdk\InsERT.Moria.Rozrachunki.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.Core">
      <HintPath>lib\nexo-sdk\InsERT.Mox.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Common.Product">
      <HintPath>lib\nexo-sdk\InsERT.Common.Product.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFrameworkSupport">
      <HintPath>lib\nexo-sdk\InsERT.Mox.EntityFrameworkSupport.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.DaneDomyslne">
      <HintPath>lib\nexo-sdk\InsERT.Moria.DaneDomyslne.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFramework.Core">
      <HintPath>lib\nexo-sdk\InsERT.Mox.EntityFramework.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy SDK DLLs to output directory -->
  <ItemGroup>
    <None Include="lib\nexo-sdk\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
