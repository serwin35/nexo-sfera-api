<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  elementFormDefault="qualified"
  targetNamespace="http://schemas.insert.com.pl/2015/hop/gratyfikant/pracownicy"
  xmlns="http://schemas.insert.com.pl/2015/hop/gratyfikant/pracownicy"
  xmlns:wspolne="http://schemas.insert.com.pl/2013/hop"
  xmlns:rachunki="http://schemas.insert.com.pl/2013/hop/rachunkibankowe"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>Dane pracowników.</xs:documentation>
  </xs:annotation>

  <xs:import id="WspolnePart" namespace="http://schemas.insert.com.pl/2013/hop" schemaLocation="Wspolne.xsd"/>
  <xs:import id="RachunkiBankowe" namespace="http://schemas.insert.com.pl/2013/hop/rachunkibankowe" schemaLocation="RachunkiBankowe.xsd"/>

  <xs:complexType name="TDokumentTozsamosci">
    <xs:annotation>
      <xs:documentation>Cechy dokumentu tożsamości.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Numer" type="xs:string">
        <xs:annotation>
          <xs:documentation>Numer dokumentu tożsamości.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataWydania" type="xs:date" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Data wydania dokumentu tożsamości.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Organ" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Nazwa organu, który wydał dokument tożsamości.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DataWaznosci" type="xs:date" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Data ważności dokumentu tożsamości.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="Typ" type="wspolne:TypDokumentuTozsamosci" use="required">
      <xs:annotation>
        <xs:documentation>Typ dokumentu tożsamości.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="TWyplacanieWynagrodzenia">
    <xs:restriction base="xs:string">
      <xs:enumeration value="KoniecMiesiaca">
        <xs:annotation>
          <xs:documentation>Do końca miesiąca.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="10DzienNastepnego">
        <xs:annotation>
          <xs:documentation>Do 10 dnia następnego miesiąca.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TPrzychodyDlaMlodych">
    <xs:sequence>
      <xs:element name="Przychody" type="xs:decimal">
          <xs:annotation>
            <xs:documentation>Przychody dla pracowników przed ukończeniem 26. roku życia powyżej limitu przychodów zwolnionych z PIT lub gdy pracownik zrezygnował ze zwolnienia z PIT.</xs:documentation>
          </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyZwolnione" type="xs:decimal">
          <xs:annotation>
            <xs:documentation>Przychody zwolnione z PIT dla pracowników przed ukończeniem 26. roku życia.</xs:documentation>
          </xs:annotation>
      </xs:element>
      <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal">
          <xs:annotation>
            <xs:documentation>Przychody zwolnione z PIT dla pracowników przed ukończeniem 26. roku życia.</xs:documentation>
          </xs:annotation>
      </xs:element>
      
      <xs:element name="PrzychodyPrawaAutorskie" type="xs:decimal" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Przychody z praw autorskich z wypłat dla pracowników przed ukończeniem 26. roku życia powyżej limitu przychodów zwolnionych z PIT lub gdy pracownik zrezygnował ze zwolnienia z PIT.</xs:documentation>
          </xs:annotation>
      </xs:element>
      <xs:element name="KosztyAutorskie" type="xs:decimal" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Koszty przychodów autorskich z wypłat dla pracowników przed ukończeniem 26. roku życia powyżej limitu przychodów zwolnionych z PIT lub gdy pracownik zrezygnował ze zwolnienia z PIT.</xs:documentation>
          </xs:annotation>
      </xs:element>
    
      <xs:element name="Zaliczki" type="xs:decimal">
          <xs:annotation>
            <xs:documentation>Zaliczki na podatek dla pracowników przed ukończeniem 26. roku życia powyżej limitu przychodów zwolnionych z PIT lub gdy pracownik zrezygnował ze zwolnienia z PIT.</xs:documentation>
          </xs:annotation>
      </xs:element>
      <xs:element name="SkladkiZUS" type="xs:decimal">
        <xs:annotation>
            <xs:documentation>Składki ZUS płatne przez pracownika dla pracowników przed ukończeniem 26. roku życia powyżej limitu przychodów zwolnionych z PIT lub gdy pracownik zrezygnował ze zwolnienia z PIT.</xs:documentation>
        </xs:annotation>
      </xs:element>  
      <xs:element name="SkladkiZUSOdPrzychZwolnionych" type="xs:decimal" minOccurs="0">
        <xs:annotation>
            <xs:documentation>Składki ZUS finansowane przez pracownika od przychodów zwolnionych z PIT z wynagrodzeń dla pracowników przed ukończeniem 26. roku życia. Pole nieużywane od wersji 41.
            </xs:documentation>
        </xs:annotation>
      </xs:element>  
      <xs:element name="SkladkiZdrowotneOdliczone" type="xs:decimal">
        <xs:annotation>
            <xs:documentation>Składki zdrowotne odliczane od podatku dla pracowników przed ukończeniem 26. roku życia powyżej limitu przychodów zwolnionych z PIT lub gdy pracownik zrezygnował ze zwolnienia z PIT.</xs:documentation>
        </xs:annotation>
      </xs:element>  
      <xs:element name="SkladkiZdrowotneOdliczoneOdPrzychZwolnionych" type="xs:decimal">
        <xs:annotation>
            <xs:documentation>Składki zdrowotne odliczane od podatku od przychodów zwolnionych z PIT z wynagrodzeń dla pracowników przed ukończeniem 26. roku życia.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyPraktykiAbsolwenckie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Przychody z praktyk absolwenckich.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyPraktykiAbsolwenckieZwolnione" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Przychody zwolnione z podatku z praktyk absolwenckich.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ZaliczkiPraktykiAbsolwenckie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Zaliczki pobrane przez płatnika z praktyk absolwenckich.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyZasilkiMacierzynskie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Przychody z zasiłków macierzyńskich.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyZasilkiMacierzynskieZwolnione" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Przychody zwolnione z podatku z zasiłków macierzyńskich.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ZaliczkiZasilkiMacierzynskie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Zaliczki pobrane przez płatnika z zasiłków macierzyńskich.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TPrzychodyDlaSeniorow">
    <xs:sequence>
      <xs:element name="Przychody" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Przychody dla pracowników od uzyskania wieku emerytalnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyZwolnione" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Przychody zwolnione z PIT dla pracowników od uzyskania wieku emerytalnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Przychody zwolnione z PIT dla pracowników od uzyskania wieku emerytalnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyPrawaAutorskie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Przychody z praw autorskich z wypłat dla pracowników od uzyskania wieku emerytalnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KosztyAutorskie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Koszty przychodów autorskich z wypłat dla pracowników od uzyskania wieku emerytalnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Zaliczki" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Zaliczki na podatek dla pracowników od uzyskania wieku emerytalnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SkladkiZUS" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Składki ZUS płatne przez pracownika od uzyskania wieku emerytalnego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PrzychodyZasilkiMacierzynskie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Przychody z zasiłków macierzyńskich.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ZaliczkiZasilkiMacierzynskie" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Zaliczki pobrane przez płatnika z zasiłków macierzyńskich.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
    

  <xs:complexType name="TPrzychody">
    <xs:sequence>
      <xs:element name="Wyplaty" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Dane dotyczące przychodów z wypłat.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Przychody" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Przychody.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Koszty uzyskania przychodów.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="PrzychodyPrawaAutorskie" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Przychody z praw autorskich.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="KosztyAutorskie" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Koszty autorskie.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="Zaliczki" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Zaliczki pobrane przez płatnika.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="SkladkiZUS" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Składki ZUS finansowane przez pracownika.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="SkladkiZdrowotne" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Składki na ubezpieczenie zdrowotne.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="SkladkiZdrowotneOdliczone" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Składki na ubezpieczenie zdrowotne odliczane od podatku.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="PrzychodyPraktykiAbsolwenckie" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Przychody z praktyk absolwenckich.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="ZaliczkiPraktykiAbsolwenckie" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Zaliczki pobrane przez płatnika z praktyk absolwenckich.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="PrzychodyZasilkiMacierzynskie" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Przychody z zasiłków macierzyńskich.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="ZaliczkiZasilkiMacierzynskie" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Zaliczki pobrane przez płatnika z zasiłków macierzyńskich.</xs:documentation>
              </xs:annotation>
            </xs:element>            
            <xs:element name="DlaMlodych" type="TPrzychodyDlaMlodych" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Informacje o przychodach uzyskanych przed ukończeniem 26. roku życia.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="DlaSeniorow" type="TPrzychodyDlaSeniorow" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Informacje o przychodach uzyskanych od uzyskania wieku emerytalnego.</xs:documentation>
              </xs:annotation>
              </xs:element>
            <xs:element name="KwotaZwolnieniaZPodatkuDlaSeniora" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Kwota zwolnienia z podatku - ulga dla seniora.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="KwotaZwolnieniaZPodatkuDlaPowracajacego" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Kwota zwolnienia z podatku - ulga dla powracającego z zagranicy.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="KwotaZwolnieniaZPodatkuDlaRodzin4Plus" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Kwota zwolnienia z podatku - ulga dla rodziny 4+.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="KwotaZwolnieniaZasilkiMacierzynskieDlaSenioraPowracajacegoRodzin4Plus" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Kwota zwolnienia z podatku - zasiłki macierzyńskie zwolnione z podatku dla seniorów, powracających, rodzin 4+.</xs:documentation>
              </xs:annotation>
            </xs:element>            
            <xs:element name="SkladkiZUSOdPrzychZwolnionych" type="xs:decimal" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Składki ZUS finansowane przez pracownika od przychodów zwolnionych z PIT.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Rachunki" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Dane dotyczące przychodów z rachunków.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="SkladkiZUS" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Składki ZUS finansowane przez pracownika (z wszystkich rodzajów przychodów).</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="SkladkiZdrowotne" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Składki na ubezpieczenie zdrowotne (z wszystkich rodzajów przychodów).</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="SkladkiZdrowotneOdliczone" type="xs:decimal">
              <xs:annotation>
                <xs:documentation>Składki na ubezpieczenie zdrowotne odliczane od podatku (z wszystkich rodzajów przychodów).</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name ="Umowy">
              <xs:annotation>
                <xs:documentation>Działalność wykonywana osobiście (art. 13 pkt 2, 4-9).</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Przychody" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Przychody.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Koszty uzyskania przychodów.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Zaliczki" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Zaliczki pobrane przez płatnika.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name ="ObowiazkiSpoleczne">
              <xs:annotation>
                <xs:documentation>Czynności związane z pełnieniem obowiązków społecznych lub obywatelskich.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Przychody" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Przychody.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Koszty uzyskania przychodów.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Zaliczki" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Zaliczki pobrane przez płatnika.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name ="DzialalnoscZlecenie" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Należności z tytułu umowy zlecenie (art. 13 pkt 8).</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Przychody" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Przychody.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Koszty uzyskania przychodów.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Zaliczki" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Zaliczki pobrane przez płatnika.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="DlaMlodych" type="TPrzychodyDlaMlodych" minOccurs="0">
                        <xs:annotation>
                          <xs:documentation>Informacje o przychodach uzyskanych przed ukończeniem 26. roku życia.</xs:documentation>
                        </xs:annotation>
                  </xs:element>
                  <xs:element name="DlaSeniorow" type="TPrzychodyDlaSeniorow" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Informacje o przychodach uzyskanych od uzyskania wieku emerytalnego.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name ="PrawaAutorskie">
              <xs:annotation>
                <xs:documentation>Prawa autorskie.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="PrzychodyPowyzejLimitu" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Przychody powyżej limitu.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PrzychodyZPodwyzszonymiKosztami" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Przychody, do których zastosowano podwyższone koszty.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Koszty uzyskania przychodów.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Zaliczki" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Zaliczki pobrane przez płatnika.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name ="InneZrodla">
              <xs:annotation>
                <xs:documentation>Inne źródła.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Przychody" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Przychody.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="KosztyUzyskaniaPrzychodow" type="xs:decimal" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Koszty uzyskania przychodów (dodane w wersji 29).</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Zaliczki" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Zaliczki pobrane przez płatnika.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name ="PraktykiAbsolwenckie" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Praktyki absolwenckie.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Przychody" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Przychody.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Zaliczki" type="xs:decimal">
                    <xs:annotation>
                      <xs:documentation>Zaliczki pobrane przez płatnika.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PrzychodyDlaMlodych" type="xs:decimal">
