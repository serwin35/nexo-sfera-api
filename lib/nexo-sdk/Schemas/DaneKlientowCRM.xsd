<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2019/hop/daneklientowcrm"
           xmlns="http://schemas.insert.com.pl/2019/hop/daneklientowcrm"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="DaneKlientowCRM">
    <xs:annotation>
      <xs:documentation>Dane klientów CRM.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:element name="DaneKlientaCRM">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Rodzaj" type="TRodzajKlientaCRM">
                <xs:annotation>
                  <xs:documentation>Rodzaj klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Sygnatura" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Sygnatura klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Imie" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Imię klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Nazwisko" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Nazwisko klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="DataOkolicznosciowa" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Data okolicznościowa.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ZrodloPozyskania" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Źródło pozyskania klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="DataPozyskania" type ="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Data pozyskania klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Powitanie" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Tekst powitania klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Zdjecie" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Ścieżka względna do zdjęcia.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Domena" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Domena e-maila.</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="TRodzajKlientaCRM">
    <xs:annotation>
      <xs:documentation>Rodzaj klienta CRM.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Pracownik" />
      <xs:enumeration value="Kontrahent" />
    </xs:restriction>
  </xs:simpleType>

</xs:schema>