<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" 
           elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2015/hop/gratyfikant/kategorieelementowbibliotekidokumentow"
           xmlns="http://schemas.insert.com.pl/2015/hop/gratyfikant/kategorieelementowbibliotekidokumentow"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:annotation>
    <xs:documentation>Kategorie elementów biblioteki dokumentów.</xs:documentation>
  </xs:annotation>

  <xs:complexType name="TKategoriaElementowBibliotekiDokumentow">
    <xs:annotation>
      <xs:documentation>Dane kategorii elementów biblioteki dokumentów.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Nazwa" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nazwa kategorii elementów biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Opis" type="xs:string">
        <xs:annotation>
          <xs:documentation>Opis kategorii elementów biblioteki dokumentów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Domyslna" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Określa czy kategoria jest domyślna.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Gratyfikant" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Określa czy kategoria dotyczy danych kadrowych z Gratyfikanta.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="KategorieElementowBibliotekiDokumentow">
    <xs:annotation>
      <xs:documentation>Kategorie elementów biblioteki dokumentów.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded" >
        <xs:element name="Kategoria" type="TKategoriaElementowBibliotekiDokumentow">
          <xs:annotation>
            <xs:documentation>Kategoria elementów biblioteki dokumentów.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
</xs:schema>
