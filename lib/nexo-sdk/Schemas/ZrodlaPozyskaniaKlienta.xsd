<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2014/hop/zrodlapozyskaniaklienta"
           xmlns="http://schemas.insert.com.pl/2014/hop/zrodlapozyskaniaklienta"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:annotation>
    <xs:documentation>Źrodła pozyskania klientów.</xs:documentation>
  </xs:annotation>

  <xs:complexType name="TZrodloPozyskaniaKlienta">
    <xs:annotation>
      <xs:documentation>Dane źródła pozyskania klienta.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Nazwa" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nazwa źródła pozyskania klienta.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="ZrodlaPozyskaniaKlienta">
    <xs:annotation>
      <xs:documentation>Źródła pozyskania klientów.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Zrodlo" type="TZrodloPozyskaniaKlienta" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>