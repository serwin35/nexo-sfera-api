<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2014/hop/parametrydzialan"
           xmlns="http://schemas.insert.com.pl/2014/hop/parametrydzialan"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:w="http://schemas.insert.com.pl/2013/hop">

  <xs:import id="WspolnePart" namespace="http://schemas.insert.com.pl/2013/hop" schemaLocation="Wspolne.xsd"/>
  
  <xs:annotation>
    <xs:documentation>Parametry działań.</xs:documentation>
  </xs:annotation>

  <xs:complexType name="TParametryDzialan">
    <xs:annotation>
      <xs:documentation>Parametry działań.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="WlasneRozszerzone">
        <xs:annotation>
          <xs:documentation>Definicje rozszerzonych pól własnych dla działania.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="PoleRozszerzone" type="w:TPoleWlasneRozszerzone">
              <xs:annotation>
                <xs:documentation>Definicja pola własnego rozszerzonego.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="ParametryDzialan" type="TParametryDzialan">
    <xs:annotation>
      <xs:documentation>Parametry dzialań.</xs:documentation>
    </xs:annotation>
  </xs:element>
  
</xs:schema>