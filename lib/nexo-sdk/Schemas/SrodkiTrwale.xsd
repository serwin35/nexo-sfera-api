<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2018/hop/srodkitrwale"
           xmlns="http://schemas.insert.com.pl/2018/hop/srodkitrwale"
           xmlns:wspolne="http://schemas.insert.com.pl/2013/hop"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:import id="WspolnePart" namespace="http://schemas.insert.com.pl/2013/hop" schemaLocation="Wspolne.xsd"/>
      
  <xs:simpleType name="TRodzajWNiP">
    <xs:annotation>
      <xs:documentation>Określa rodzaj WNiP.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="InneWartosciNiematerialne"/>
      <xs:enumeration value="KosztZakonczonychPrac"/>
      <xs:enumeration value="WartoscFirmy"/>
      <xs:enumeration value="Zaliczki"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TTypST">
    <xs:annotation>
      <xs:documentation>Określa typ pozycji (ST, WNiP).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="SrodekTrwaly"/>
      <xs:enumeration value="WNiP"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name ="TSposobNabycaST">
    <xs:annotation>
      <xs:documentation>Określa sposób nabycia środka trwałego.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Zakup"/>
      <xs:enumeration value="Aport"/>
      <xs:enumeration value="Dzierzawa"/>
      <xs:enumeration value="NieodplatnePrzyjecie"/>
      <xs:enumeration value="UjawnienieNadwyzki"/>
      <xs:enumeration value="Wytworzenie"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name ="TSrodekTrwalyInfo">
    <xs:annotation>
      <xs:documentation>Skrócone dane środka trwałego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="Numer" type="xs:long"  />
      <xs:element minOccurs="1" maxOccurs="1" name="Nazwa" type="wspolne:Obowiazkowy" />
      <xs:element minOccurs="1" maxOccurs="1" name="Typ" type="TTypST" />
    </xs:sequence>
    <xs:attribute form="unqualified" name="Ident" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="TKlasyfikacjaSrodkaTrwalego">
    <xs:annotation>
      <xs:documentation>Dane klasyfikacyjne środka trwałego.</xs:documentation>
    </xs:annotation>
      <xs:sequence>
        <xs:element minOccurs="1" maxOccurs="1" name="Nr" type="wspolne:Obowiazkowy" />
        <xs:element minOccurs="1" maxOccurs="1" name="Nazwa" type="wspolne:Obowiazkowy" />
      </xs:sequence>
      <xs:attribute form="unqualified" name="Ident" type="xs:string" />
  </xs:complexType>
  
  <xs:complexType name="TSrodekTrwaly">
    <xs:annotation>
      <xs:documentation>Pełne dane środka trwałego.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="Numer" type="xs:long" />
      <xs:element minOccurs="1" maxOccurs="1" name="Nazwa" type="wspolne:Obowiazkowy" />
      <xs:element minOccurs="1" maxOccurs="1" name="Typ" type="TTypST"/>

      <xs:element minOccurs="0" maxOccurs="1" name="KST" type="TKlasyfikacjaSrodkaTrwalego"/>
	  <xs:element minOccurs="0" maxOccurs="1" name="KST2016" type="TKlasyfikacjaSrodkaTrwalego"/>
      <xs:element minOccurs="0" maxOccurs="1" name="TypWNiP" type="TRodzajWNiP" />
                            
      <xs:element minOccurs="1" maxOccurs="1" name="NrInwentarzowy" type="wspolne:Obowiazkowy" />
      <xs:element minOccurs="0" maxOccurs="1" name="GUS" type="xs:string" />
      <!--
      <xs:element minOccurs="0" maxOccurs="1" name="WartoscPoczatkowa" type="wspolne:Obowiazkowy" />
      <xs:element minOccurs="0" maxOccurs="1" name="Analityka" type="xs:string" />
      -->
      <xs:element minOccurs="0" maxOccurs="1" name="Charakterystyka" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="Sprzedawca" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="Produkcja">
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="1" name="Producent" type="xs:string" />
            <xs:element minOccurs="0" maxOccurs="1" name="Rok" type="xs:string" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Techniczne">
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="1" name="Dane" type="xs:string" />
            <xs:element minOccurs="0" maxOccurs="1" name="Stan" type="xs:string" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Nabycie">
      <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="1" maxOccurs="1" name="Data" type="xs:date" />
            <xs:element minOccurs="0" maxOccurs="1" name="Wartosc" type="xs:decimal" />
            <xs:element minOccurs="0" maxOccurs="1" name="Dokument" type="xs:string" />
            <xs:element minOccurs="0" maxOccurs="1" name="Sposob" type="TSposobNabycaST"/>                          
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element minOccurs="0" name="WlasneRozszerzone">
        <xs:annotation>
          <xs:documentation>Wartości pól własnych środków trwałych.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="0" maxOccurs="unbounded" name="PoleRozszerzone">
              <xs:annotation>
                <xs:documentation>Pole własne rozszerzone podmiotu. Zawartość tego elementu jest wartością pola.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:simpleContent>
                  <xs:extension base="xs:string">
                    <xs:attribute name="Nazwa" type="xs:string" use="required">
                      <xs:annotation>
                        <xs:documentation>Nazwa pola własnego.</xs:documentation>
                      </xs:annotation>
                    </xs:attribute>
                  </xs:extension>
                </xs:simpleContent>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="FlagaWlasna" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Dane flagi własnej.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:all>
            <xs:element minOccurs="1" maxOccurs="1" name="Kolor" type="xs:string">
              <xs:annotation>
                <xs:documentation>Kolor flagi własnej.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="Ksztalt" type="xs:string">
              <xs:annotation>
                <xs:documentation>Kształt flagi własnej.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="Komentarz" type="xs:string">
              <xs:annotation>
                <xs:documentation>Komentarz flagi własnej.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:all>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute form="unqualified" name="Ident" type="wspolne:Obowiazkowy"  />
  </xs:complexType>
  

  <xs:complexType name="TSrodkiTrwale">
    <xs:annotation>
      <xs:documentation>Kolekcja środków trwałych.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="SrodekTrwaly" maxOccurs="unbounded" minOccurs="0" type="TSrodekTrwaly">
        <xs:annotation>
          <xs:documentation>Środek trwały.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="SrodkiTrwale" type="TSrodkiTrwale">
    <xs:annotation>
      <xs:documentation>Środki trwałe.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>