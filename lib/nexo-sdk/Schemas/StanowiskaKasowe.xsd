<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://schemas.insert.com.pl/2013/hop/stanowiskakasowe"
           elementFormDefault="qualified"
           xmlns="http://schemas.insert.com.pl/2013/hop/stanowiskakasowe"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>Kasy i stanowska kasowe.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="TStanowisko">
    <xs:annotation>
      <xs:documentation>Stanowisko kasowe.</xs:documentation>
    </xs:annotation>  
    <xs:all>
      <xs:element name="Nazwa" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nazwa stanowiska kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Symbol" type="xs:string">
        <xs:annotation>
          <xs:documentation>Symbol stanowiska kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Opis" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Opis stanowiska kasowego.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="StanSrodkow">
        <xs:annotation>
          <xs:documentation>Informacje o środkach na stanowisku kasowym w podziale na formy płatności.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Stan" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Wysokość środków związanych z formą płatności.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="Kwota" type="xs:decimal" use="required">
                  <xs:annotation>
                    <xs:documentation>Wysokość środków związanych z określoną formą płatności.</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="FormaPlatnosci" type="xs:string" use="required">
                  <xs:annotation>
                    <xs:documentation>Nazwa formy płatności.</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="FormyPlatnosci" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Formy płatności akceptowane na danym stanowisku kasowym.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence minOccurs="0">
            <xs:element name="FormaPlatnosci" type="xs:string" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Nazwa formy płatności.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="Domyslne" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>Określa, czy stanowisko kasowe jest domyślnym stanowiskiem w kasie.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="TKasa">
    <xs:annotation>
      <xs:documentation>Dane kasy.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="Nazwa" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nazwa kasy.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Symbol" type="xs:string">
        <xs:annotation>
          <xs:documentation>Unikalny symbol kasy.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Opis" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Opis kasy.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Stanowiska">
        <xs:annotation>
          <xs:documentation>Lista stanowisk w kasie.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Stanowisko" minOccurs="1" maxOccurs="unbounded" type="TStanowisko">
              <xs:annotation>
                <xs:documentation>Stanowisko kasowe.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="TKasy">
    <xs:annotation>
      <xs:documentation>Lista kas.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Kasa" minOccurs="0" maxOccurs="unbounded" type="TKasa">
        <xs:annotation>
          <xs:documentation>Kasa.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Kasy" type="TKasy">
    <xs:annotation>
      <xs:documentation>Lista kas.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>
