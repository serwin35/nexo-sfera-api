                          </xs:annotation>
                        </xs:enumeration>
                        <xs:enumeration value="OdDaty">
                          <xs:annotation>
                            <xs:documentation>Komunikat ma być wyświetlany po upływie daty podanej w elemencie Data.</xs:documentation>
                          </xs:annotation>
                        </xs:enumeration>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="Aktywny" use="required" type="xs:boolean">
                    <xs:annotation>
                      <xs:documentation>Określa, czy komunikat przy wystawianu dokumentu podmiotowi ma być pokazywany.</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
              <xs:element name="BibliotekaDokumentow" type="wspolne:TBibliotekaDokumentow" minOccurs="0">
