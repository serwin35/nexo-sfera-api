                      <xs:annotation>
                        <xs:documentation>Obsługuj przy sprzedaży.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <xs:element name="TransakcjaHandlowaSprzedaz" minOccurs="0" type="xs:string">
