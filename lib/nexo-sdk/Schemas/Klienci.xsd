<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  attributeFormDefault="unqualified"
  elementFormDefault="qualified"
  xmlns="http://schemas.insert.com.pl/2018/hop/klienci"
  targetNamespace="http://schemas.insert.com.pl/2018/hop/klienci"
  xmlns:rachunki="http://schemas.insert.com.pl/2013/hop/rachunkibankowe"
  xmlns:wspolne="http://schemas.insert.com.pl/2013/hop"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>Kartoteka klientów</xs:documentation>
  </xs:annotation>

  <xs:include schemaLocation="ParametryKontrahentow.xsd"/>
  <xs:import id="WspolnePart" namespace="http://schemas.insert.com.pl/2013/hop" schemaLocation="Wspolne.xsd"/>
  <xs:import id="RachunkiBankowe" namespace="http://schemas.insert.com.pl/2013/hop/rachunkibankowe" schemaLocation="RachunkiBankowe.xsd"/>

  <xs:complexType name="PrzedstawicielFirmy">
    <xs:annotation>
      <xs:documentation>Przedstawiciel firmy.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Firma" type="xs:string">
        <xs:annotation>
          <xs:documentation>Symbol podmiotu-firmy, którego jest przedstawicielem.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Dzial" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Dział w jakim pracuje przedstawiciel.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Stanowisko" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Stanowisko na jakim pracuje przedstawiciel.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Pokoj" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Pokój w którym pracuje przedstawiciel.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="Podstawowy" type="xs:boolean" use="optional">
      <xs:annotation>
        <xs:documentation>Określa, czy jest to podstawowy kontakt.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="Podmioty">
    <xs:annotation>
      <xs:documentation>Dane o podmiotach (klientach).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="Podmiot">
          <xs:annotation>
            <xs:documentation>Dane podmiotu (klienta).</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" name="Sygnatura" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Symbol podmiotu. Opcjonalny tylko dla podmiotów jednorazowych.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" name="Aktywny" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Znacznik określający aktywność klienta. Domyślnie aktywny.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:choice>
                <xs:element minOccurs="0" name="DaneFirmy">
                  <xs:annotation>
                    <xs:documentation>Dane podmiotu o typie Firma.</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:all>
                      <xs:element name="REGON" type="xs:string" minOccurs="0">
                        <xs:annotation>
                          <xs:documentation>REGON podmiotu. Niepoprawny nie zostanie zaimportowany.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                      <xs:element name="Nazwa" type="xs:string">
                        <xs:annotation>
                          <xs:documentation>Pełna nazwa podmiotu.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                      <xs:element name="NazwaSkrocona" type="xs:string">
                        <xs:annotation>
                          <xs:documentation>Skrócona nazwa podmiotu.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                    </xs:all>
                  </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" name="DaneOsoby">
                  <xs:annotation>
                    <xs:documentation>Dane podmiotu o typie Osoba.</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:all>
                      <xs:element name="Imie" type="xs:string">
                        <xs:annotation>
                          <xs:documentation>Imię osoby.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                      <xs:element name="Nazwisko" type="xs:string">
                        <xs:annotation>
                          <xs:documentation>Nazwisko osoby.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                      <xs:element name="PESEL" type="xs:string" minOccurs="0">
                        <xs:annotation>
                          <xs:documentation>Numer PESEL osoby.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                      <xs:element name="DokumentTozsamosci" type="wspolne:DokumentTozsamosci" minOccurs="0">
                        <xs:annotation>
                          <xs:documentation>Cechy dokumentu tożsamości osoby.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                      <xs:element name="PrzedstawicielFirmy" type="PrzedstawicielFirmy" minOccurs="0">
                        <xs:annotation>
                          <xs:documentation>Dane związane z przedstawicielstwem osoby.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                      <xs:element minOccurs="0" name="RolnikRyczaltowy" type="xs:boolean">
                        <xs:annotation>
                          <xs:documentation>Określa czy osoba jest rolnikiem ryczałtowym.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                    </xs:all>
                  </xs:complexType>
                </xs:element>
              </xs:choice>
              <xs:element name="NIP" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>NIP podmiotu.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="UE" minOccurs="0" type="wspolne:FirmaUE">
                <xs:annotation>
                  <xs:documentation>Cechy rejestracji podmiotu w zakresie handlu w UE.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Kontakty" type="wspolne:Kontakty" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dane kontaktowe podmiotu.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Adresy" type="wspolne:Adresy">
                <xs:annotation>
                  <xs:documentation>Adresy podmiotu.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="Uwagi" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Uwagi do podmiotu.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="Region" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Nazwa regionu, do którego należy podmiot.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="Branze">
                <xs:annotation>
                  <xs:documentation>Kolekcja przypisanych branży.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Branza" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Nazwa branży.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element minOccurs="0" name="Grupa" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Nazwa grupy, do której należy podmiot.</xs:documentation>
                </xs:annotation>
              </xs:element>
              
              <xs:element minOccurs="0" name="Cechy">
                <xs:annotation>
                  <xs:documentation>Kolekcja przypisanych cech.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Cecha" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Nazwa cechy.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element minOccurs="0" name="RachunkiBankowe">
                <xs:annotation>
                  <xs:documentation>Lista rachunków bankowych podmiotu.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Rachunek" type="rachunki:TRachunekBankowyKlienta">
                      <xs:annotation>
                        <xs:documentation>Rachunek bankowy podmiotu.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element minOccurs="0" name="Wlasne">
                <xs:annotation>
                  <xs:documentation>Wartości pól własnych podmiotu.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Pole">
                      <xs:annotation>
                        <xs:documentation>Pole własne podmiotu. Zawartość tego elementu jest wartością pola.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:string">
                            <xs:attribute name="Nazwa" type="xs:string" use="required">
                              <xs:annotation>
                                <xs:documentation>Nazwa pola własnego.</xs:documentation>
                              </xs:annotation>
                            </xs:attribute>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element minOccurs="0" name="WlasneRozszerzone">
                <xs:annotation>
                  <xs:documentation>Wartości pól własnych podmiotu.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="PoleRozszerzone">
                      <xs:annotation>
                        <xs:documentation>Pole własne rozszerzone podmiotu. Zawartość tego elementu jest wartością pola.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:string">
                            <xs:attribute name="Nazwa" type="xs:string" use="required">
                              <xs:annotation>
                                <xs:documentation>Nazwa pola własnego.</xs:documentation>
                              </xs:annotation>
                            </xs:attribute>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element minOccurs="0" name="Oddzialy">
                <xs:annotation>
                  <xs:documentation>Lista oddziałów podmiotu.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="Oddzial" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Symbol firmy będącej oddziałem podmiotu.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element minOccurs="0" name="Opiekun" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Symbol użytkownika będącego opiekunem podmiotu. Jeśli ten element będzie pusty nie zostanie ustawiony żaden opiekun. Jeśli tego elementu nie będzie to opiekun będzie domyślny, czyli wykonujący przeniesienie danych Szef.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="PreferowanyKontakt" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Nazwa preferowanego przez podmiot rodzaju kontaktu. Jeśli nie istnieje to zostanie dodany. Przykłady: telefon, faks, e-mail.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element name="ZgodaDaneOsobowe" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Zgoda na przetwarzanie danych osobowych.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="Jest" use="optional" type="xs:boolean">
                    <xs:annotation>
                      <xs:documentation>Określa, czy została wyrażona zgoda na przetwarzanie danych osobowych.</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>

              <xs:element name="ZgodaMarketing" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Zgoda na wysyłanie informacji marketingowych.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="Jest" use="optional" type="xs:boolean">
                    <xs:annotation>
                      <xs:documentation>Określa, czy została wyrażona zgoda na wysyłanie informacji marketingowych.</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>

              <xs:element name="ZgodaKomunikacja" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Zgoda na wysyłanie informacji drogą elektroniczną.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="Jest" use="optional" type="xs:boolean">
                    <xs:annotation>
                      <xs:documentation>Określa, czy została wyrażona zgoda na wysyłanie informacji drogą elektroniczną.</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
                
              <xs:element name="Zgody" type="TZgody" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dane dotyczące zgód wyrażonych i odrzuconych przez klienta.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element name="OpisKsiegowy" minOccurs="0" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Domyślny opis księgowy przypisany podmiotowi.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element name="UwagiKsiegowe" minOccurs="0" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Domyślne uwagi księgowe przypisane podmiotowi.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element name="EwVATSpOpis" minOccurs="0" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Domyślny opis ewidencji VAT sprzedaży przypisany podmiotowi.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="EwVATSpTransakcja">
                <xs:annotation>
                  <xs:documentation>Domyślna transakcja ewidencji VAT sprzedaży przypisana podmiotowi.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="null"></xs:enumeration>
                    <xs:enumeration value="DK">
                      <xs:annotation>
                        <xs:documentation>Dostawa krajowa.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="DK-ZVP">
                      <xs:annotation>
                        <xs:documentation>Dostawa krajowa - zwrot VAT podróżnym.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="DPTK">
                      <xs:annotation>
                        <xs:documentation>Dostawa towarów i usług poza terytorium kraju.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="SUPTK">
                      <xs:annotation>
                        <xs:documentation>Świadczenie usług, poza terytorium kraju.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="WDT">
                      <xs:annotation>
                        <xs:documentation>Wewnątrzwspólnotowa dostawa towarów.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="IU-N">
                      <xs:annotation>
                        <xs:documentation>Import usług (podatek należny).</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="IU-PU-N">
                      <xs:annotation>
                        <xs:documentation>Import usług, dla których podatkiem jest usługobiorca (podatek należny).</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="IT-PU-N">
                      <xs:annotation>
                        <xs:documentation>Import towarów w procedurze uproszczonej (podatek należny).</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="ET">
                      <xs:annotation>
                        <xs:documentation>Eksport towarów.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="WTT-D">
                      <xs:annotation>
                        <xs:documentation>Transakcja trójstronna (dostawa).</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="RL">
                      <xs:annotation>
                        <xs:documentation>Remanent likwidacyjny.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="WNT-N">
                      <xs:annotation>
                        <xs:documentation>Wewnątrzwspólnotowe nabycie towarów (podatek należny).</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="WNT-ST-N">
                      <xs:annotation>
                        <xs:documentation>Wewnątrzwspólnotowe nabycie towarów - środek transportu (podatek należny).</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="DTU-PN-D">
                      <xs:annotation>
                        <xs:documentation>Dostawa towarów i świadczenie usług, dla których podatnikiem jest nabywca - dostawa.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="DTU-PN-N">
                      <xs:annotation>
                        <xs:documentation>Dostawa towarów i świadczenie usług, dla których podatnikiem jest nabywca - nabycie.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>


              <xs:element name="EwVATZakOpis" minOccurs="0" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Domyślny opis ewidencji VAT zakupu przypisany podmiotowi.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="EwVATZakTransakcja">
                <xs:annotation>
                  <xs:documentation>Domyślna transakcja ewidencji VAT zakupu przypisana podmiotowi.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="null"></xs:enumeration>
                    <xs:enumeration value="NKST">
                      <xs:annotation>
                        <xs:documentation>Nabycie krajowe środka trwałego.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="NK">
                      <xs:annotation>
                        <xs:documentation>Nabycie krajowe.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="WNT">
                      <xs:annotation>
                        <xs:documentation>Wewnątrzwspólnotowe nabycie towarów.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="WNT-ST">
                      <xs:annotation>
                        <xs:documentation>Wewnątrzwspólnotowe nabycie towarów - środek transportu.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="IU">
                      <xs:annotation>
                        <xs:documentation>Import usług.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="IU-PU">
                      <xs:annotation>
                        <xs:documentation>Import usług, dla których podatnikiem jest usługobiorca.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="WTT-N">
                      <xs:annotation>
                        <xs:documentation>Transakcja trójstronna - nabycie.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="RC">
                      <xs:annotation>
                        <xs:documentation>Odwrócone obciążenie.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="IT-PU">
                      <xs:annotation>
                        <xs:documentation>Import towarów w procedurze uproszczonej.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="NK-K">
                      <xs:annotation>
                        <xs:documentation>Korekta podatku naliczonego od pozostałych nabyć.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="NKST-K">
                      <xs:annotation>
                        <xs:documentation>Korekta podatku naliczonego od nabyć środków trwałych.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <xs:element minOccurs="0" name="EwVATZakEksp">
                <xs:annotation>
                  <xs:documentation>Domyślne odliczenie dla pojazdów.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="null"></xs:enumeration>
                    <xs:enumeration value="nd">
                      <xs:annotation>
                        <xs:documentation>Nie dotyczy.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="czesciowe">
                      <xs:annotation>
                        <xs:documentation>Częściowe odliczenie.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="pelne">
                      <xs:annotation>
                        <xs:documentation>Pełne odliczenie.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <xs:element minOccurs="0" name="EwVATZakRodzaj">
                <xs:annotation>
                  <xs:documentation>Domyślny rodzaj zakupu.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="null"></xs:enumeration>
                    <xs:enumeration value="inwestycyjne">
                      <xs:annotation>
                        <xs:documentation>Inwestycyjne</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="zaopatrzeniowe">
                      <xs:annotation>
                        <xs:documentation>Zaopatrzeniowe.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="kosztowe">
                      <xs:annotation>
                        <xs:documentation>Kosztowe.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <xs:element minOccurs="0" name="EwVATZakRodzajOdl">
                <xs:annotation>
                  <xs:documentation>Domyślny rodzaj odliczenia.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="null"></xs:enumeration>
                    <xs:enumeration value="calkowite">
                      <xs:annotation>
                        <xs:documentation>Całkowite.</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="proporcjonalne">
                      <xs:annotation>
