                </xs:annotation>
              </xs:element>

              <xs:element name="Rabat" minOccurs="0" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Nazwa rabatu przypisanego podmiotowi.</xs:documentation>
                </xs:annotation>
              </xs:element>
                
              <xs:element name="Negocjacja" minOccurs="0" type="xs:boolean">
