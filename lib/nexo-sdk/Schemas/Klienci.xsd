                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="Kredyt" type="TKredytKupiecki">
                <xs:annotation>
                  <xs:documentation>Określa parametry kredytowania kupieckiego dla kontrahenta.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element minOccurs="0" name="MetodaKasowa" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Określa czy podmiot rozlicza się przy pomocy metody kasowej.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element name="Komunikat" minOccurs="0">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="Tekst" type ="xs:string" minOccurs="0" >
                      <xs:annotation>
                        <xs:documentation>Treść komunikatu wyświetlanego przy wystawianiu dokumentu podmiotowi.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Data" type ="xs:date" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Data, od której ma być wyświetlany komunikat przy wystawianiu dokumentu podmiotowi, gdy atrybut Pokaz ma wartosc OdDaty.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:all>
                  <xs:attribute name="Pokaz" use="required">
                    <xs:annotation>
                      <xs:documentation>Określa, kiedy komunikat ma być pokazywany.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="Zawsze">
