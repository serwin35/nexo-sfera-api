<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2015/hop/parametryklientapoczty"
           xmlns="http://schemas.insert.com.pl/2015/hop/parametryklientapoczty"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:w="http://schemas.insert.com.pl/2013/hop">

  <xs:annotation>
    <xs:documentation>Parametry klienta poczty.</xs:documentation>
  </xs:annotation>

  <xs:complexType name="TParametryKlientaPoczty">
    <xs:annotation>
      <xs:documentation>Parametry klienta poczty.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Uzytkownik" type="xs:string">
        <xs:annotation>
          <xs:documentation>Sygantura użytkownika, który zdefiniował wartości parametrów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Format" type="TFormatWiadomosci" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Domyślny format wiadomości.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="OznaczJakoPrzeczytanaPo" type="xs:int" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Określa po jakim czasie wiadomość ma zostać oznaczona jako przeczytana </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="BlokujSkrypty" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Określa, czy wykonywanie skryptów w dokumentach HTML jest włączone.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="ParametryKlientaPoczty">
    <xs:annotation>
      <xs:documentation>Parametry klienta poczty.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Parametry" type="TParametryKlientaPoczty">
          <xs:annotation>
            <xs:documentation>Parametry klienta poczty.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="TFormatWiadomosci">
    <xs:annotation>
      <xs:documentation>Format.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="HTML" />
      <xs:enumeration value="Tekst" />
    </xs:restriction>
  </xs:simpleType>
  
</xs:schema>