<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           targetNamespace="http://schemas.insert.com.pl/2015/hop/gratyfikant/slowniki"
           xmlns="http://schemas.insert.com.pl/2015/hop/gratyfikant/slowniki"
           xmlns:wspolne="http://schemas.insert.com.pl/2013/hop"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:import id="WspolnePart" namespace="http://schemas.insert.com.pl/2013/hop" schemaLocation="Wspolne.xsd"/>
  
  <xs:annotation>
    <xs:documentation>Informacje o słownikach związanych z kadrami/płacami.</xs:documentation>
  </xs:annotation>

  <xs:complexType name="TWartosc">
    <xs:sequence>
      <xs:element name="Prog" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Próg stawki wynagrodzenia.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Wartosc" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Wartość stawki wynagrodzenia.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TStawkaAkordow">
    <xs:sequence>
      <xs:element name="Nazwa" type="wspolne:Obowiazkowy">
        <xs:annotation>
          <xs:documentation>Nazwa stawki akordów.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Rodzaj" type="wspolne:Obowiazkowy">
        <xs:annotation>
          <xs:documentation>Nazwa rodzaju stawki akordów</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Jednostka" type="wspolne:Obowiazkowy">
        <xs:annotation>
          <xs:documentation>Nazwa jednostki.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Wartosci">
        <xs:annotation>
          <xs:documentation>Wartości stawki akordów.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Wartosc" type="TWartosc" minOccurs="1" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Wartość stawki akordów.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TStawkaProwizji">
    <xs:sequence>
      <xs:element name="Nazwa" type="wspolne:Obowiazkowy">
        <xs:annotation>
          <xs:documentation>Nazwa stawki prowizji.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Wartosci">
        <xs:annotation>
          <xs:documentation>Wartości stawki prowizji.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Wartosc" type="TWartosc" minOccurs="1" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Wartość stawki prowizji.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TSlowniki">
    <xs:sequence>
      <xs:element name="StawkiAkordow">
        <xs:annotation>
          <xs:documentation>Dane dotyczące słownika stawek akordow.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="StawkaAkordow" type="TStawkaAkordow" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Dane dotyczace stawki akordow.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="StawkiProwizji">
        <xs:annotation>
          <xs:documentation>Dane dotyczące słownika stawek prowizji.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="StawkaProwizji" type="TStawkaProwizji" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Dane dotyczące stawki prowizji.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:element name="Slowniki" type="TSlowniki">
    <xs:annotation>
      <xs:documentation>Dane dotyczące słowników.</xs:documentation>
    </xs:annotation>
  </xs:element>
  
</xs:schema>