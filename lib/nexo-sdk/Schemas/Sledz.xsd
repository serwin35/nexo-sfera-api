                          <xs:element name="SkladkaRentowa"
                                  type="TSkladkaBudzetowaRentowa"
                                  minOccurs="0"
                                  maxOccurs="1"/>
                        </xs:all>
                        <xs:attribute name="Nalicza" type="TBool" use="optional"/>
                      </xs:complexType>
                    </xs:element>
