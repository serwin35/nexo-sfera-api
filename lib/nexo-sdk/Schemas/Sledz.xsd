                    type="TObliczeniaZWartoscia" />
        <xs:element name="KwotaWylaczonaZPodstawySkladekZUS"
                    minOccurs="0"
                    maxOccurs="1"
                    type="TObliczeniaZWartoscia" />
        <xs:element name="SkladkiZUS"
