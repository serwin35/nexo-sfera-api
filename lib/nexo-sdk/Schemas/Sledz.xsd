                                <xs:attribute name="PodstawaSkorygowana" type="xs:string" use="optional"/>
                                <xs:attribute name="Wartosc" type="xs:string" use="required"/>
                              </xs:complexType>
                            </xs:element>
                            <xs:element name="SkladkaEmerytalna"
