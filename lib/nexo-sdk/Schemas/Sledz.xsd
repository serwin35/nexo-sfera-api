            <xs:attribute name="KwotaZwolniona" type="xs:string" use="optional"/>
            <xs:attribute name="WplataNaPPK" type="xs:string" use="optional"/>
            <xs:attribute name="Wartosc" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
