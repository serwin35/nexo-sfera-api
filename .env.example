# Nexo Sfera API Environment Configuration
# Copy this file to .env and customize for your environment
# DO NOT commit .env file to version control!

# ============================================
# SQL Server Connection
# ============================================
SFERA_SERVER=(local)\INSERTNEXO
SFERA_DATABASE=Nexo_demo_1

# Authentication: Set to 'true' for Windows Auth, 'false' for SQL Auth
SFERA_USE_WINDOWS_AUTH=true

# SQL Authentication (only if SFERA_USE_WINDOWS_AUTH=false)
SFERA_SQL_LOGIN=
SFERA_SQL_PASSWORD=

# ============================================
# Nexo Application Credentials
# ============================================
SFERA_NEXO_LOGIN=Szef
SFERA_NEXO_PASSWORD=your-password-here

# Product type: Subiekt, Rachmistrz, Rewizor, or Gratyfikant
SFERA_PRODUCT=Subiekt

# ============================================
# API Configuration
# ============================================
# API authentication key (generate a secure random string)
API_KEY=your-secure-api-key-here

# API port (default: 5000)
API_PORT=5000

# ============================================
# Logging
# ============================================
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT_ASPNETCORE=Warning
LOGGING__LOGLEVEL__NEXOSFERAAPI=Information
